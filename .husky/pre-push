# Husky v9 pre-push — Harvard-grade enforcement.
# Husky v9 shim is in .husky/_/h; do NOT add a `#!/usr/bin/env sh` line here.
#
# THREE-LAYER BRANCH GOVERNANCE:
#   Layer 1: This pre-push hook (immediate feedback)
#   Layer 2: GitHub Ruleset (server-side enforcement)
#   Layer 3: Branch Governance workflow (continuous audit)
#
# Validates:
#   1) Branch naming convention (dev, master, feat/*, fix/*, chore/*, etc.)
#   2) Blocks direct pushes to master (PR required)
#   3) AGENTS.md knowledge-base gate (app code without its AGENTS.md update)
#   4) Runs full test suite before push
#
# Allowed branch patterns:
#   - dev, master (main branches)
#   - feat/*, fix/*, chore/*, ci/*, docs/*, refactor/*, perf/*, test/*, build/*, style/*, hotfix/*, release/*, revert/*
#
# Bypass: `git push --no-verify` (see docs/branch-protection.md).

# stdin (one line per pushed ref: local_ref local_sha remote_ref remote_sha) is a
# one-shot stream — slurp it once so every section below can re-read it.
push_refs_file=$(mktemp)
cat > "$push_refs_file"
trap 'rm -f "$push_refs_file"' EXIT

# --- 1) Validate current branch naming convention ---
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# Allowed patterns: dev, master, or conventional commit prefix + slash
if [ -n "$current_branch" ]; then
  case "$current_branch" in
    dev|master)
      # Main branches - allowed
      ;;
    feat/*|fix/*|chore/*|ci/*|docs/*|refactor/*|perf/*|test/*|build/*|style/*|hotfix/*|release/*|revert/*)
      # Feature branches following conventional commits - allowed
      ;;
    *)
      echo ""
      echo "❌ Branch name does not follow convention: $current_branch"
      echo ""
      echo "   Allowed patterns:"
      echo "     - dev, master (main branches)"
      echo "     - feat/*, fix/*, chore/*, ci/*, docs/*, refactor/*, perf/*, test/*"
      echo "     - build/*, style/*, hotfix/*, release/*, revert/*"
      echo ""
      echo "   Examples:"
      echo "     ✅ dev"
      echo "     ✅ feat/add-login"
      echo "     ✅ fix/broken-api"
      echo "     ✅ chore/update-deps"
      echo ""
      echo "   Bypass: git push --no-verify (see GOVERNANCE.md)"
      echo ""
      exit 1
      ;;
  esac
fi

# --- 2) Block direct push to master (PR required) ---
blocked_master=0

# Check stdin for master pushes
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ]; then
    blocked_master=1
  fi
done < "$push_refs_file"

# Also block if current branch is master
if [ "$current_branch" = "master" ]; then
  blocked_master=1
fi

if [ "$blocked_master" -eq 1 ]; then
  echo ""
  echo "❌ Direct push to master is blocked — open a Pull Request from dev."
  echo ""
  echo "   Workflow:"
  echo "     1. git push origin dev"
  echo "     2. gh pr create --base master --fill"
  echo ""
  echo "   Bypass: git push --no-verify (see GOVERNANCE.md)"
  echo ""
  exit 1
fi

# --- 3) AGENTS.md knowledge-base gate (fail fast, before tests) ---
# Blocks the push when apps/<app>/** changed without its apps/<app>/AGENTS.md
# in the pushed range (backend, ingestion-telegram, frontend independently).
# Root docs, infra, scripts and workflows never trigger (out of scope).
agents_missing=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  case "$local_sha" in
    0000000000000000000000000000000000000000|"") continue ;; # branch deletion: nothing to check
  esac
  case "$remote_sha" in
    0000000000000000000000000000000000000000|"")
      # New remote branch: no upstream range — fall back to merge-base.
      agents_base=""
      for agents_up in origin/dev origin/master; do
        agents_base=$(git merge-base "$local_sha" "$agents_up" 2>/dev/null || true)
        [ -n "$agents_base" ] && break
      done
      if [ -z "$agents_base" ]; then
        echo "⚠️  AGENTS gate: cannot resolve base for $local_ref (no origin/dev nor origin/master) — skipping range check for this ref."
        continue
      fi
      agents_range_base="$agents_base"
      ;;
    *)
      agents_range_base="$remote_sha"
      ;;
  esac
  agents_files=$(git diff --name-only "$agents_range_base" "$local_sha" -- 2>/dev/null || true)
  for agents_app in backend ingestion-telegram frontend; do
    agents_touched=$(printf '%s\n' "$agents_files" | grep "^apps/$agents_app/" | grep -v "^apps/$agents_app/AGENTS.md$" || true)
    if [ -n "$agents_touched" ] && ! printf '%s\n' "$agents_files" | grep -qx "apps/$agents_app/AGENTS.md"; then
      agents_missing="${agents_missing}  - apps/$agents_app/AGENTS.md (triggered by: $(printf '%s' "$agents_touched" | tr '\n' ' ' | cut -c1-300))
"
    fi
  done
done < "$push_refs_file"

if [ -n "$agents_missing" ]; then
  echo ""
  echo "❌ Push blocked: app code changed without its AGENTS.md knowledge-base update."
  echo ""
  printf '%s' "$agents_missing"
  echo ""
  echo "   Update the AGENTS.md file(s) above to describe the change, commit, and push again."
  echo "   Do NOT use --no-verify to skip this: it exists for emergencies only —"
  echo "   bypassing it rots the knowledge base the whole team (and every agent) relies on."
  echo ""
  exit 1
fi

# --- 4) Run full test suite (mirrors CI Tests job) ---
echo ""
echo "🧪 Running tests before push..."
npm run test:ci