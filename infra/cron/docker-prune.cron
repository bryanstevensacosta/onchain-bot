# =====================================================================
# infra/cron/docker-prune.cron — canonical cron fragment for the droplet
# =====================================================================
#
# This file is the single source of truth for cron jobs that should run
# on the self-hosted runner host (droplet CryptoGanster).
#
# Install (idempotent — re-running it is a no-op if already installed):
#
#   sudo crontab -u runner -l 2>/dev/null | grep -q 'docker system prune' \
#     || ( sudo crontab -u runner -l 2>/dev/null; \
#          cat infra/cron/docker-prune.cron ) \
#        | sudo crontab -u runner -
#
# Verify:
#
#   sudo crontab -u runner -l 2>/dev/null | grep -E 'docker system prune'
#
# Uninstall (remove every line that contains "docker system prune"):
#
#   sudo crontab -u runner -l 2>/dev/null \
#     | grep -v 'docker system prune' \
#     | sudo crontab -u runner -
#
# ---------------------------------------------------------------------
# Timezone: droplet runs UTC. The 02:00 UTC window is between deploy
# windows and is the lowest-traffic hour for the ingest pipeline.
# ---------------------------------------------------------------------

# Nightly docker system prune — reclaims 1-3 GB/day of dangling images
# left behind by `docker compose build` after `up -d` without
# --force-recreate. The --filter until=72h backstop protects any image
# less than 3 days old (one full deploy cycle + a 48 h margin) from
# being pruned while a still-running container references it. Aligns
# with the staging deploy's `--filter "until=24h"` (line 208 of
# .github/workflows/deploy-staging.yml) plus a 48 h margin.
0 2 * * * /usr/bin/docker system prune --force --filter "until=72h" >> /var/log/docker-prune.log 2>&1
