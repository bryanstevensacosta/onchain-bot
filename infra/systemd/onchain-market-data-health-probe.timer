# =====================================================================
# onchain-market-data-health-probe.timer — hourly health sampling for
# the market-data staging 24h p95 cutover gate (owner-approved
# 2026-10-22). Persistent=true so a host reboot does not silently
# shrink the window.
#
# Install: see onchain-market-data-health-probe.service header.
# Read the samples:
#   cat /home/ubuntu/market-data-health-24h.jsonl
# p95 over the last 24h:
#   jq -r 'select(.ts > (now - 86400 | todate)) | .ms' \
#     /home/ubuntu/market-data-health-24h.jsonl | sort -n | \
#     awk '{a[NR]=$1} END{print a[int(NR*0.95)]}'
# =====================================================================
[Unit]
Description=Hourly market-data staging health probe (24h SLO gate)

[Timer]
OnCalendar=hourly
AccuracySec=1min
Persistent=true
Unit=onchain-market-data-health-probe.service

[Install]
WantedBy=timers.target
