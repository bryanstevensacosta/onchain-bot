[Unit]
Description=Socat proxy for ingestion (Tailscale {TAILSCALE_IP}:{TAILSCALE_PORT} → localhost:{LOCAL_PORT})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/socat TCP-LISTEN:{TAILSCALE_PORT},fork,reuseaddr,bind={TAILSCALE_IP} TCP:127.0.0.1:{LOCAL_PORT}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
