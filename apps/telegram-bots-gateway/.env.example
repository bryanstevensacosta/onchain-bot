# telegram-bots-gateway — copy to .env / .env.dev (gitignored), NEVER commit secrets.
# Generate a key: openssl rand -hex 32 (DISTINCT per env).

# Gateway HTTP (dev :4070, staging :4071, prod :4072)
BOTS_GATEWAY_PORT=4070

# Tier-1 required: AES-256-GCM master key (64-hex direct, else SHA-256 hashed).
# Empty -> fail-closed boot error, no listen.
ENCRYPTION_KEY=

# Own logical DB (same server per env): onchain_bot_bots (dev+prod), onchain_bot_bots_staging (staging)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onchain_bot_bots
DATABASE_SYNCHRONIZE=true

# Avatar cache (permanent, janitor-excluded)
AVATAR_DIR=uploads/avatars
