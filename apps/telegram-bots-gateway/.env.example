# telegram-bots-gateway — copy to .env / .env.dev (gitignored), NEVER commit secrets.
# Generate a key: openssl rand -hex 32 (DISTINCT per env).

# Gateway HTTP (dev :4070, staging :4071, prod :4072)
BOTS_GATEWAY_PORT=4070

# Tier-1 required: AES-256-GCM master key (64-hex direct, else SHA-256 hashed).
# Empty -> fail-closed boot error, no listen.
ENCRYPTION_KEY=

# Own logical DB (same server per env): onchain_bot_bots (dev+prod), onchain_bot_bots_staging (staging)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onchain_bot_bots
DATABASE_SYNCHRONIZE=true

# Avatar cache (permanent, janitor-excluded)
AVATAR_DIR=uploads/avatars

# Service auth between apps (todo 2): per-client keys with scopes (send|admin).
# JSON object; empty/absent = keyless dev (guards fail open). DISTINCT secrets
# per env; fill by hand on the server, NEVER commit.
# Example: {"kol-system":{"secret":"<rand>","scopes":["send"]},"ops-admin":{"secret":"<rand>","scopes":["admin"]}}
BOTS_GATEWAY_CLIENTS=

# HMAC clock-skew window in seconds (timestamp+nonce anti-replay).
BOTS_GATEWAY_CLOCK_SKEW_SEC=300

# Bot API base (override ONLY for local mock-Telegram live tests).
TELEGRAM_API_BASE=https://api.telegram.org

# Ingress router (todo 3): per-bot routes keyed by bot id. Each route
# carries the per-route webhook secret (Telegram `secret_token`) and the
# subscribed apps that receive pass-through fan-out. Empty = no routes
# (register via PUT /api/ingress/:botId/subscriptions, admin scope).
# Example: {"<vault-bot-id>":{"webhookSecret":"<rand>","mode":"webhook",
#   "subscribers":[{"appId":"kol-system","url":"http://kol:3050/ingress"}]}}
BOTS_GATEWAY_INGRESS=

# Fan-out delivery tuning (todo 3): bounded retries + backoff per
# subscriber before a dead-letter record is written.
BOTS_GATEWAY_FANOUT_MAX_ATTEMPTS=4
BOTS_GATEWAY_FANOUT_BACKOFF_MS=200,1000,5000
