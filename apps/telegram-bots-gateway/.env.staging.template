# telegram-bots-gateway — staging template (placeholders, NO secrets).
# Deploy: scp .env.staging.template OracleDroplet:/opt/onchain-bot-staging/apps/telegram-bots-gateway/.env.staging
# then fill ENCRYPTION_KEY by hand on the server (openssl rand -hex 32).
BOTS_GATEWAY_PORT=4071
ENCRYPTION_KEY=
DATABASE_URL=postgres://postgres:postgres@onchain-bot-postgres-staging:5432/onchain_bot_bots_staging
DATABASE_SYNCHRONIZE=false
AVATAR_DIR=uploads/avatars
# Per-client service keys (send|admin scopes, DISTINCT secrets per env, fill on server).
BOTS_GATEWAY_CLIENTS=
BOTS_GATEWAY_CLOCK_SKEW_SEC=300
