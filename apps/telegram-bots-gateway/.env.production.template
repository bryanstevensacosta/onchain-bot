# telegram-bots-gateway — production template (placeholders, NO secrets).
# Deploy: scp .env.production.template OracleDroplet:/opt/onchain-bot/apps/telegram-bots-gateway/.env.production
# then fill ENCRYPTION_KEY by hand on the server (openssl rand -hex 32).
BOTS_GATEWAY_PORT=4072
ENCRYPTION_KEY=
DATABASE_URL=postgres://postgres:postgres@onchain-bot-postgres-production:5432/onchain_bot_bots
DATABASE_SYNCHRONIZE=false
AVATAR_DIR=uploads/avatars
# Per-client service keys (send|admin scopes, DISTINCT secrets per env, fill on server).
BOTS_GATEWAY_CLIENTS=
BOTS_GATEWAY_CLOCK_SKEW_SEC=300
# Ingress router (todo 3): per-bot routes + fan-out tuning (see .env.example).
BOTS_GATEWAY_INGRESS=
BOTS_GATEWAY_FANOUT_MAX_ATTEMPTS=4
BOTS_GATEWAY_FANOUT_BACKOFF_MS=200,1000,5000
