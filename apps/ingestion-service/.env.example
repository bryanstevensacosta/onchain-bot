# =====================================================================
# Ingestion Service Environment Variables
# =====================================================================
# Copy this file to .env and fill in your actual values
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1. TELEGRAM MTPROTO CREDENTIALS (REQUIRED)
# ─────────────────────────────────────────────────────────────────────
# ⚠️ CRITICAL: These values must ONLY exist in ingestion-service .env
# ⚠️ Remove these from backend .env to prevent AUTH_KEY_DUPLICATED errors
# 
# Obtain from: https://my.telegram.org/apps
INGESTION_TELEGRAM_MTPROTO_API_ID=12345678
INGESTION_TELEGRAM_MTPROTO_API_HASH=abcdef1234567890abcdef1234567890

# Session string from existing MTProto client
# Generate with: cd apps/backend && npm run telegram:gen-session
INGESTION_TELEGRAM_MTPROTO_SESSION=your_session_string_here

# ─────────────────────────────────────────────────────────────────────
# 2. API SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────
# Port for HTTP API (health, media, SSE streaming)
INGESTION_PORT=3031

# Public-facing URL for media file serving
# Used to construct media URLs in SSE payloads
INGESTION_API_BASE_URL=http://localhost:3031

# ─────────────────────────────────────────────────────────────────────
# 3. REDIS CONFIGURATION (REQUIRED for cursor tracking)
# ─────────────────────────────────────────────────────────────────────
INGESTION_REDIS_HOST=localhost
INGESTION_REDIS_PORT=6379
INGESTION_REDIS_DB=0
INGESTION_REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# 4. DATABASE CONFIGURATION (REQUIRED for raw text storage)
# ─────────────────────────────────────────────────────────────────────
INGESTION_DATABASE_HOST=localhost
INGESTION_DATABASE_PORT=5432
INGESTION_DATABASE_NAME=onchain_bot
INGESTION_DATABASE_USER=postgres
INGESTION_DATABASE_PASSWORD=postgres
INGESTION_DATABASE_SYNCHRONIZE=false
INGESTION_DATABASE_LOGGING=false

# ─────────────────────────────────────────────────────────────────────
# 5. CHANNEL SEEDER CONFIGURATION (JSON Arrays)
# ─────────────────────────────────────────────────────────────────────
# KOL channels to monitor
# Format: [{"channelId":"-1001234567890","displayName":"KOL Alpha"}]
INGESTION_TELEGRAM_SEED_KOLS=[]

# Crypto news channels to monitor
# Format: [{"channelId":"-1009876543210","displayName":"Crypto News"}]
INGESTION_TELEGRAM_SEED_NEWS=[]

# ─────────────────────────────────────────────────────────────────────
# 6. ANTI-BAN SAFETY CONFIGURATION (OPTIONAL - uses safe defaults)
# ─────────────────────────────────────────────────────────────────────
# Maximum channels to monitor (default: 50)
INGESTION_SAFETY_MAX_CHANNELS=50

# Base polling interval per channel in ms (default: 90000 = 90s)
INGESTION_SAFETY_POLL_INTERVAL_BASE_MS=90000

# Jitter percentage for staggered polling (default: 30)
INGESTION_SAFETY_JITTER_PERCENT=30

# Sleep window (24h format, default: 04:00-08:00 UTC)
INGESTION_SAFETY_SLEEP_WINDOW_START=04:00
INGESTION_SAFETY_SLEEP_WINDOW_END=08:00

# FLOOD_WAIT protection
INGESTION_SAFETY_FLOOD_INITIAL_BACKOFF_MS=5000
INGESTION_SAFETY_FLOOD_BACKOFF_MULTIPLIER=2
INGESTION_SAFETY_FLOOD_MAX_BACKOFF_MS=3600000
INGESTION_SAFETY_FLOOD_MAX_ATTEMPTS=5
INGESTION_SAFETY_FLOOD_THRESHOLD_24H=10

# ─────────────────────────────────────────────────────────────────────
# 7. MEDIA RETENTION CONFIGURATION (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────
# Media file retention in hours (default: 72h)
INGESTION_CRYPTO_NEWS_MEDIA_RETENTION_HOURS=72

# ─────────────────────────────────────────────────────────────────────
# 8. LOGGING CONFIGURATION (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────
# Log level: debug, info, warn, error (default: info)
INGESTION_LOG_LEVEL=info

# Log format: json, simple (default: json)
INGESTION_LOG_FORMAT=json

# ─────────────────────────────────────────────────────────────────────
# 9. NODE ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
