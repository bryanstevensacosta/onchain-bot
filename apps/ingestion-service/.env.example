# ─────────────────────────────────────────────────────────────
# Ingestion Service Configuration
# ─────────────────────────────────────────────────────────────

# Server
PORT=3031
NODE_ENV=development

# MTProto Telegram Configuration
INGESTION_TELEGRAM_API_ID=
INGESTION_TELEGRAM_API_HASH=
INGESTION_TELEGRAM_MTPROTO_SESSION=

# Redis (for LastSeenManager cursor persistence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage
UPLOADS_ROOT=./uploads

# API
INGESTION_API_BASE_URL=http://localhost:3031

# Anti-Ban Protection (Per Requirement 11)
INGESTION_MAX_CHANNELS=50
INGESTION_POLL_INTERVAL_MS=90000
INGESTION_JITTER_PERCENT=30
INGESTION_SLEEP_START=04:00
INGESTION_SLEEP_END=08:00
INGESTION_FLOOD_INITIAL_MS=5000
INGESTION_FLOOD_MULTIPLIER=2
INGESTION_FLOOD_MAX_MS=3600000
INGESTION_FLOOD_MAX_ATTEMPTS=5

# Database (optional, for raw message storage)
DATABASE_ENABLED=false
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=onchain_bot

# Logging
LOG_LEVEL=info

# Backend URLs (for CORS)
BACKEND_STAGING_URL=http://staging-backend:3030
BACKEND_PROD_URL=http://prod-backend:3030
