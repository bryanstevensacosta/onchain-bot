# =====================================================================
# dexter-onchain-bot STAGING TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# Copy this file to .env.staging on the droplet and fill REAL values.
# OPERATOR-CONFIRM the destination path on first deploy (no dexter
# deploy workflow exists yet; nothing copied anywhere).
# Ports: staging host :4061 -> container :4060 (C-PORTS-01).
# DB: onchain_bot_dexter_staging (C-DB-01).
# =====================================================================

NODE_ENV=staging

DEXTER_ENABLED=true

# Container port (host mapping 4061:4060 lives in
# docker-compose.staging.yml; compose `environment:` wins over this file).
DEXTER_PORT=4060

# Telegram bot token (lookup bot). Fill on the droplet; NEVER commit.
DEXTER_BOT_TOKEN=

DEXTER_WEBHOOK_SECRET=
DEXTER_WEBHOOK_URL=

# Staging ingest mode (webhook behind the droplet reverse proxy)
DEXTER_INGEST_MODE=webhook
DEXTER_POLLING_INTERVAL_MS=1000
DEXTER_POLLING_TIMEOUT_SEC=30

# Upstream market-data staging instance (host :4001)
MARKET_DATA_URL=http://onchain-bot-market-data-staging:4000
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_MS=2000

DEXTER_RATE_LIMIT_PER_USER=30
DEXTER_DEFAULT_TRADE_BUTTONS=DEX,PHO,TRO

# Postgres (staging logical DB owned by dexter-onchain-bot).
# Example: postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_dexter_staging
DATABASE_URL=postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_dexter_staging
DATABASE_SYNCHRONIZE=false

REDIS_URL=redis://redis:6379/2
