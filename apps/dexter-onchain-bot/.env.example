# =====================================================================
# dexter-onchain-bot Environment Variables (Tramo 3, todo 9, P13)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Ports: dev :4060 / staging host :4061 / prod host :4062 (C-PORTS-01).
# DBs: onchain_bot_dexter[_staging] (C-DB-01: new apps own their
# logical DB; same server as the backend DB per env).
# Lookup-only bot: NEVER publishes to channels, no scoring/tracking.
# =====================================================================

# Master switch for the dexter bot service
DEXTER_ENABLED=false

# HTTP port for this service (dev 4060, staging host 4061, prod 4062)
DEXTER_PORT=4060

# Bind address: loopback-only by default. Expose wider ONLY as an
# explicit operator decision (0.0.0.0 or the Tailscale IP on Oracle).
DEXTER_HOST=127.0.0.1

# Telegram bot token (lookup bot). Migrated from CHAIN_DEXTER_BOT_TOKEN:
# DEXTER_BOT_TOKEN wins when set; the legacy name still works as fallback.
# Direct-leg credential only (deprecated) — the gateway leg resolves the
# token server-side from the vault id (see DEXTER_BOT_VAULT_ID below).
DEXTER_BOT_TOKEN=
# Legacy name (deprecated, still honored as fallback — see bot.config.ts):
# CHAIN_DEXTER_BOT_TOKEN=

# Webhook secret (required in production webhook mode; dev may run polling)
DEXTER_WEBHOOK_SECRET=
DEXTER_WEBHOOK_URL=

# Ingest mode: webhook (prod/staging) or polling (dev default)
DEXTER_INGEST_MODE=polling
DEXTER_POLLING_INTERVAL_MS=1000
DEXTER_POLLING_TIMEOUT_SEC=30

# Upstream market-data service (todo 5 bridge, default-true here):
# the ONLY market-data source for this app (no local providers, no cache).
MARKET_DATA_URL=http://localhost:4000
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_MS=2000

# Per-user command rate limit (sliding window): N commands per minute
# per Telegram user id. Over-budget messages are dropped with a warning.
DEXTER_RATE_LIMIT_PER_USER=30

# telegram-bots-gateway client (todo 6, dual-send migration):
# gateway base (dev :4070, staging :4071, prod :4072), HMAC client
# credentials (empty = keyless/unsigned dev), send path
# (direct|dual|gateway, default dual), and the vault id for this bot
# (filled after POST /api/dexter-bots/migrate-to-gateway).
BOTS_GATEWAY_URL=http://localhost:4070
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
DEXTER_SEND_MODE=dual
DEXTER_BOT_VAULT_ID=
# Shared secret for the gateway fan-out ingress (POST /dexter/ingress).
# Empty = accept unsigned with a warn (dev only).
DEXTER_INGRESS_SECRET=

# Default trade buttons (subset of DEX,PHO,TRO,TRT,JUP,MAE,BAN,BM)
DEXTER_DEFAULT_TRADE_BUTTONS=DEX,PHO,TRO

# Postgres connection (logical DB owned by dexter-onchain-bot, C-DB-01).
# Reserved for future persistence; v1 runs on in-memory chat settings.
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5440/onchain_bot_dexter

# TypeORM auto-sync (dev/test only; staging/prod use migrations)
DATABASE_SYNCHRONIZE=true

# Redis connection (reserved for future rate-limit windows)
REDIS_URL=redis://localhost:6387/0
