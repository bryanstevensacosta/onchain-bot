# =====================================================================
# dexter-onchain-bot PRODUCTION TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# Copy this file to .env.production on the droplet and fill REAL values.
# OPERATOR-CONFIRM the destination path on first deploy (no dexter
# deploy workflow exists yet; nothing copied anywhere).
# Ports: prod host :4062 -> container :4060 (C-PORTS-01).
# DB: onchain_bot_dexter (C-DB-01).
# =====================================================================

NODE_ENV=production

DEXTER_ENABLED=true
DEXTER_PORT=4060

# Telegram bot token (lookup bot). Fill on the droplet; NEVER commit.
DEXTER_BOT_TOKEN=

DEXTER_WEBHOOK_SECRET=
DEXTER_WEBHOOK_URL=

DEXTER_INGEST_MODE=webhook
DEXTER_POLLING_INTERVAL_MS=1000
DEXTER_POLLING_TIMEOUT_SEC=30

# Upstream market-data prod instance (host :4002)
MARKET_DATA_URL=http://onchain-bot-market-data:4000
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_MS=2000

DEXTER_RATE_LIMIT_PER_USER=30
DEXTER_DEFAULT_TRADE_BUTTONS=DEX,PHO,TRO

# Postgres (prod logical DB owned by dexter-onchain-bot).
# Example: postgres://onchain_bot:<PROD_PG_PASSWORD>@postgres:5432/onchain_bot_dexter
DATABASE_URL=postgres://onchain_bot:<PROD_PG_PASSWORD>@postgres:5432/onchain_bot_dexter
DATABASE_SYNCHRONIZE=false

REDIS_URL=redis://redis:6379/2
