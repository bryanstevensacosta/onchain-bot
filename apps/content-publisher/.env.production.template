# =====================================================================
# content-publisher PRODUCTION TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the production env file on the droplet.
# Copy this file to .env.production on the droplet and fill REAL values.
# OPERATOR-CONFIRM the destination path on first deploy (no
# content-publisher deploy workflow exists yet; nothing copied anywhere).
# =====================================================================

NODE_ENV=production

# Master switch (adopted initial: OFF until cutover rehearsal, todo 10)
CONTENT_PUBLISHER_ENABLED=false

# Cutover flag (adopted initial: OFF — backend legacy serves traffic
# until todo 11 flips dev -> staging -> prod on day 1/3/7)
USE_CONTENT_PUBLISHER=false

# Production port (dev 3040 / staging 3041 / prod 3042)
CONTENT_PUBLISHER_PORT=3042

# Inbound API key (REQUIRED in production)
CONTENT_PUBLISHER_API_KEY=

# Owning ingestion-telegram instance (production, per-env model).
# Prod: host 127.0.0.1:3032 -> container :3031. Do NOT point prod
# at staging (:3033) or dev (:3031).
INGESTION_TELEGRAM_URL=http://onchain-bot-ingestion-telegram:3031

# Upstream key for the prod ingestion (P30: sent as x-api-key on SSE +
# feed reads). Prod side: INGESTION_API_KEY. Copy from the prod
# ingestion instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by content-publisher, prod).
# C-DB-01: onchain_bot_content_publisher on the SAME server as the
# prod backend DB. Fill with the prod postgres password on the
# droplet; NEVER commit.
# Example: postgres://onchain_bot:<PROD_PG_PASSWORD>@postgres:5432/onchain_bot_content_publisher
DATABASE_URL=postgres://onchain_bot:<PROD_PG_PASSWORD>@postgres:5432/onchain_bot_content_publisher

# Migrations on prod (never synchronize)
DATABASE_SYNCHRONIZE=false

# Redis (prod service name)
REDIS_URL=redis://redis:6379/2

# 3-flag control (C-FLAGS-01, adopted initial: all OFF in prod)
MATCHING_ENABLED=false
LLM_ENABLED=false
PUBLISHING_ENABLED=false
MATCHING_CRON_ENABLED=false

# Queue bounds
QUEUE_TTL_HOURS=24
QUEUE_MAX_PENDING=500

# Dedup cascade (adopted initial: OFF)
DEDUP_ENABLED=false

# LLM gateway (adopted initial: mock until cutover)
USE_MOCK_AI=true
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_ATTEMPTS=3

# Ads wheel (adopted initial: OFF)
ADS_ENABLED=false
ADS_ROTATION_EVERY_N=5

# Telegram publishers (prod bot tokens, NEVER commit)
CRYPTO_NEWS_BOT_TOKEN=
THREADS_BOT_TOKEN=
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
