# =====================================================================
# Ingestion Service - Staging Twin Configuration (per-env-ingestion item 1)
# =====================================================================
# Gemelo del template prod (.env.production.template) para el staging twin
# (docker-compose.staging-ingestion.yml, host 127.0.0.1:3033 → container 3031).
# El gemelo arranca VACÍO de fuentes por diseño (sin seed, sin mirror prod).
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1. TELEGRAM MTPROTO CREDENTIALS — PENDIENTE DE OPERADOR
# ─────────────────────────────────────────────────────────────────────
# El gemelo staging usa la VIEJA cuenta de dev (una triple por env, jamás
# compartida con prod — sesión duplicada causa AUTH_KEY_DUPLICATED).
# Solo nombres de vars aquí, jamás valores. El operador genera/recupera la
# sesión con: cd apps/ingestion-telegram && npm run telegram:gen-session
# (salida redactada: pipear a archivo, jamás pegar en terminal-evidence)
# y rellena el archivo REAL (gitignored):
#   /opt/onchain-bot-staging/apps/ingestion-telegram/.env.staging
# ─────────────────────────────────────────────────────────────────────
INGESTION_TELEGRAM_MTPROTO_API_ID=
INGESTION_TELEGRAM_MTPROTO_API_HASH=
INGESTION_TELEGRAM_MTPROTO_SESSION=

# ─────────────────────────────────────────────────────────────────────
# 2. API SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────
# Canonical: INGESTION_PORT (gap 12: INGESTION_PORT > INGESTION_API_PORT
# (deprecated) > PORT (deprecated) > 3031). Internal container port stays 3031.
INGESTION_PORT=3031
# Deprecated fallbacks (prefer INGESTION_PORT):
# INGESTION_API_PORT=3031
# PORT=3031
INGESTION_API_BASE_URL=http://onchain-bot-ingestion-telegram-staging:3031

# ─────────────────────────────────────────────────────────────────────
# 3. REDIS CONFIGURATION (staging)
# ─────────────────────────────────────────────────────────────────────
INGESTION_REDIS_HOST=onchain-bot-redis-staging
INGESTION_REDIS_PORT=6379
INGESTION_REDIS_DB=0
INGESTION_REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# 4. DATABASE CONFIGURATION (staging)
# ─────────────────────────────────────────────────────────────────────
INGESTION_DATABASE_HOST=onchain-bot-postgres-staging
INGESTION_DATABASE_PORT=5432
INGESTION_DATABASE_NAME=alpha_meta_token_scanner_staging_ingestion
INGESTION_DATABASE_USER=alpha_meta_token_scanner
INGESTION_DATABASE_PASSWORD=
INGESTION_DATABASE_SYNCHRONIZE=false
INGESTION_DATABASE_LOGGING=false

# ─────────────────────────────────────────────────────────────────────
# 5. ANTI-BAN SAFETY CONFIGURATION (espejo prod)
# ─────────────────────────────────────────────────────────────────────
INGESTION_SAFETY_MAX_CHANNELS=50
INGESTION_SAFETY_POLL_INTERVAL_BASE_MS=90000
INGESTION_SAFETY_JITTER_PERCENT=30
INGESTION_SAFETY_SLEEP_WINDOW_START=04:00
INGESTION_SAFETY_SLEEP_WINDOW_END=08:00
INGESTION_SAFETY_FLOOD_INITIAL_BACKOFF_MS=5000
INGESTION_SAFETY_FLOOD_BACKOFF_MULTIPLIER=2
INGESTION_SAFETY_FLOOD_MAX_BACKOFF_MS=3600000
INGESTION_SAFETY_FLOOD_MAX_ATTEMPTS=5
INGESTION_SAFETY_FLOOD_THRESHOLD_24H=10

# ─────────────────────────────────────────────────────────────────────
# 7. MEDIA RETENTION
# ─────────────────────────────────────────────────────────────────────
INGESTION_CRYPTO_NEWS_MEDIA_RETENTION_HOURS=72

# ─────────────────────────────────────────────────────────────────────
# 8. LOGGING
# ─────────────────────────────────────────────────────────────────────
INGESTION_LOG_LEVEL=info
INGESTION_LOG_FORMAT=json

# ─────────────────────────────────────────────────────────────────────
# 9. NODE ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=production # DELIBERADO: staging twin corre como prod (pino-pretty no existe en la imagen; staging!=production crashea el boot)
