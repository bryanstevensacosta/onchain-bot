{
  "name": "@alpha-meta-token-scanner/backend",
  "version": "0.0.1",
  "description": "NestJS pipeline for discovering, validating and republishing alpha-calls from Telegram channels",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "npm run db:migrate && nest start --watch",
    "start:debug": "npm run db:migrate && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --forceExit --testTimeout=30s",
    "test:watch": "jest --watch --forceExit",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "telegram:gen-session": "node -e \"require('ts-node/register/transpile-only');require('./scripts/telegram-gen-session.ts')\"",
    "db:migrate": "node scripts/backfills/migrate.js",
    "db:migrate:dry-run": "node scripts/backfills/migrate.js --dry-run",
    "db:migrate:status": "node scripts/backfills/migrate.js --status",
    "typeorm": "typeorm-ts-node-commonjs --dataSource src/shared/common/persistence/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:generate": "npm run typeorm -- migration:generate",
    "db:backup": "bash ../../scripts/backup-db.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.18.0",
    "bs58": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.6.1",
    "onnxruntime-node": "^1.27.0",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3",
    "telegram": "^2.26.22",
    "typeorm": "^0.3.30"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bs58": "^4.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.14",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^4.8.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "useESM": true
      }
    },
    "moduleNameMapper": {
      "^telegram/events$": "<rootDir>/../../node_modules/telegram/events/index",
      "^telegram/sessions$": "<rootDir>/../../node_modules/telegram/sessions/index",
      "^telegram/(.*)$": "<rootDir>/src/telegram/$1",
      "^shared/(.*)$": "<rootDir>/src/shared/$1",
      "^discovery/(.*)$": "<rootDir>/src/discovery/$1",
      "^chain/(.*)$": "<rootDir>/src/chain/$1",
      "^token/(.*)$": "<rootDir>/src/token/$1",
      "^kol/(.*)$": "<rootDir>/src/kol/$1",
      "^dashboard/(.*)$": "<rootDir>/src/dashboard/$1",
      "^settings/(.*)$": "<rootDir>/src/settings/$1",
      "^data-provider/(.*)$": "<rootDir>/src/data-provider/$1",
      "^health/(.*)$": "<rootDir>/src/health/$1",
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
