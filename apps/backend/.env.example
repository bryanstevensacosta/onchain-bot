# =====================================================================
# BACKEND ENVIRONMENT - TEMPLATE (do NOT commit with real values)
# =====================================================================
# Copy to `.env` (or `.env.dev`, which wins) and fill in real values.
# See apps/backend/src/shared/common/config/app.config.ts for the full
# inventory. MTProto credentials live ONLY in each ingestion-telegram
# instance's own `.env` (never here — duplicating them causes
# AUTH_KEY_DUPLICATED).
# =====================================================================

# ---- Ingestion-telegram (server-to-server) ----
# Canonical base URL (default http://localhost:3031 in dev).
INGESTION_TELEGRAM_URL=http://localhost:3031
# Optional server-to-server API key for ingestion-telegram.
# Sent as header `x-api-key` on backend → ingestion calls (SSE stream at
# minimum; feed clients too). Empty = keyless (dev, keyless ingestion
# keeps working). Ingestion side env: INGESTION_API_KEY.
INGESTION_TELEGRAM_API_KEY=
# SSE mode (default true) + reconnect backoff knobs.
USE_SSE_INGESTION=true
SSE_RECONNECT_INITIAL_DELAY_MS=1000
SSE_RECONNECT_MAX_DELAY_MS=30000
