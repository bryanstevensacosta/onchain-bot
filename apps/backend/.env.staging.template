# =====================================================================
# STAGING ENVIRONMENT - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for /opt/onchain-bot-staging/.env.staging on the droplet.
# Copy this file to .env.staging on the droplet and fill with REAL values.
# Then encrypt with SOPS: sops -e .env.staging > .env.staging.enc
# =====================================================================

# ---- Application ----
NODE_ENV=staging
PORT=3031


# ---- CoinMarketCap -----
COINMARKETCAP_API_KEY=

# ---- CoinGecko -----
COINGECKO_API_KEY=

# ---- Alchemy (EVM RPC provider) ----
ALCHEMY_API_KEY=

# ---- Birdeye (Token market data) ----
BIRDEYE_API_KEY=

# ---- FluxRPC ----
FLUXRPC_API_KEY=
FLUXRPC_RPC=
FLUXRPC_WS=

# ---- Helius (Solana RPC + Enhanced APIs | Mainnet / Devnet) ----
HELIUS_API_KEY=
HELIUS_RPC_URL_MAINNET=
HELIUS_GATEKEEPER_RPC_URL_MAINNET=
HELIUS_WS_MAINNET=
HELIUS_PARSE_SOLANA_TRANSACTION_MAINNET=
HELIUS_PARSE_SOLANA_TRANSACTION_HISTORY_MAINNET=
HELIUS_RPC_URL_DEVNET=
HELIUS_WS_DEVNET=
HELIUS_PARSE_SOLANA_TRANSACTION_DEVNET=
HELIUS_PARSE_SOLANA_TRANSACTION_HISTORY_DEVNET=

# ---- Mobula ----
MOBULA_API_KEY=

# ---- Moralis ----
MORALIS_API_KEY=

# ---- Pump.dev ----
PUMPDEV_API_KEY=
PUMPDEV_WALLET_PUBLIC=
PUMPDEV_WALLET_PRIVATE=

# ---- Telegram ----
# Bot API (for sending messages to users) — STAGING bot token
TELEGRAM_BOT_TOKEN=

# MTProto API (for ingesting messages from STAGING KOL channels)
# STAGING uses different channels than production
INGESTION_TELEGRAM_MTPROTO_API_ID=
INGESTION_TELEGRAM_MTPROTO_API_HASH=
INGESTION_TELEGRAM_MTPROTO_SESSION=

# ---- Telegram Ingestion Seed ----
# Staging does NOT need to ingest - disable by default
INGESTION_TELEGRAM_SEED_ENABLED=false
INGESTION_TELEGRAM_SEED_AUTO_START=false
INGESTION_TELEGRAM_SEED_CHANNELS=

# File-backed cache of resolved channel metadata
INGESTION_TELEGRAM_METADATA_CACHE_FILE=
INGESTION_TELEGRAM_BACKFILL_ENABLED=false
INGESTION_SLEEP_START_UTC=8
INGESTION_SLEEP_END_UTC=10

# ---- Telegram Publishing ----
PUBLISHING_TELEGRAM_USE_REAL_MTPROTO=false
PUBLISHING_TELEGRAM_OUTPUT_CHANNEL=

# ---- VIP Calls Bot & Channel (STAGING) ----
VIP_CALLS_BOT_TOKEN=
VIP_CALLS_OUTPUT_CHANNEL=

# ---- Chain Dexter Bot (STAGING) ----
CHAIN_DEXTER_BOT_TOKEN=
CHAIN_DEXTER_WEBHOOK_SECRET=
CHAIN_DEXTER_INGEST_MODE=webhook
CHAIN_DEXTER_POLLING_INTERVAL_MS=1000
CHAIN_DEXTER_DEFAULT_TRADE_BUTTONS=DEX,PHO,TRO

# ---- Analytics (Background Evaluation Jobs) ----
ANALYTICS_EVALUATION_HORIZONS_HOURS=24,168,720
ANALYTICS_SCHEDULER_CRON=*/5 * * * *
ANALYTICS_SCHEDULER_ENABLED=true
ANALYTICS_SCHEDULER_BATCH_SIZE=50

# ---- Postgres (TypeORM) — connects to the postgres container via Docker network ----
# In staging, this points to the "postgres" service in docker-compose.staging.yml
DATABASE_ENABLED=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=alpha_meta_token_scanner
POSTGRES_PASSWORD=__SET_VIA_DOCKER_COMPOSE__
POSTGRES_DB=alpha_meta_token_scanner_staging
# Staging can use synchronize for dev testing
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# ---- Redis ----
# Points to the "redis" service in docker-compose.staging.yml
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__SET_VIA_DOCKER_COMPOSE__
REDIS_DB=0

# ---- Milestone notifications ----
MILESTONE_ACTIVE_WINDOW_HOURS=72
MILESTONE_SCHEDULER_CRON=*/5 * * * *
MILESTONE_SCHEDULER_ENABLED=true
MILESTONE_SCHEDULER_BATCH_SIZE=30

# ---- LLM Gateway (LiteLLM-compatible proxy) ----
# Staging may use a different LLM setup
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=opencode-zen/deepseek-v4-flash