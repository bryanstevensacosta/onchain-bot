PUMPDEV_WALLET_PRIVATE=

# =====================================================================
# ⚠️ INGESTION SERVICE MIGRATION (PRODUCTION)
# =====================================================================
# PRODUCCIÓN usa el servicio centralizado de ingestion (ingestion-service)
# Las credenciales MTProto están en apps/ingestion-service/.env (en el droplet)
#
# ⚠️ CRITICAL: NO poner credenciales MTProto aquí - causará AUTH_KEY_DUPLICATED
# ⚠️ Las credenciales deben estar SOLO en ingestion-service
#
# MIGRACIÓN:
# 1. Mover TELEGRAM_MTPROTO_* de este archivo a apps/ingestion-service/.env
# 2. Habilitar USE_SSE_INGESTION=true (abajo)
# 3. Configurar INGESTION_REMOTE_URL (abajo)
# 4. Ejecutar: ./scripts/validate-session-migration.sh
#
# Ver: docs/deployment/MIGRATION-GUIDE-DROPLET.md
# =====================================================================

# ---- Ingestion Mode Configuration ----
# CRITICAL: Set to "true" after migrating to ingestion-service
# Mientras sea "false", backend usa MTProto local (modo legacy)
USE_SSE_INGESTION=false

# URL del servicio de ingestion (interno via Docker network)
# Habilitar cuando USE_SSE_INGESTION=true
INGESTION_REMOTE_URL=http://ingestion-service:3031

# ---- Telegram Bot API (para envío) ----
# Bot API (for sending messages to users) — PRODUCTION bot token
TELEGRAM_BOT_TOKEN=

# ---- VIP Calls Bot & Channel (PRODUCTION) ----
VIP_CALLS_BOT_TOKEN=
VIP_CALLS_OUTPUT_CHANNEL=

# ---- Chain Dexter Bot (PRODUCTION) ----
CHAIN_DEXTER_BOT_TOKEN=
CHAIN_DEXTER_WEBHOOK_SECRET=
CHAIN_DEXTER_INGEST_MODE=webhook
CHAIN_DEXTER_POLLING_INTERVAL_MS=1000

# ---- Crypto-news publisher (Bot API) ----
CRYPTO_NEWS_BOT_TOKEN=
CRYPTO_NEWS_OUTPUT_CHANNEL=
USE_MOCK_AI=false

# ---- Analytics (Background Evaluation Jobs) ----
ANALYTICS_EVALUATION_HORIZONS_HOURS=24,168,720
ANALYTICS_SCHEDULER_CRON=*/5 * * * *
ANALYTICS_SCHEDULER_ENABLED=true
ANALYTICS_SCHEDULER_BATCH_SIZE=50

# ---- Postgres (TypeORM) — connects to the postgres container via Docker network ----
# In production, this points to the "postgres" service in docker-compose.prod.yml
DATABASE_ENABLED=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=alpha_meta_token_scanner
POSTGRES_PASSWORD=__SET_VIA_DOCKER_COMPOSE__
POSTGRES_DB=alpha_meta_token_scanner
# CRITICAL: synchronize MUST be false in production — use migrations instead
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# ---- Redis ----
# Points to the "redis" service in docker-compose.prod.yml
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__SET_VIA_DOCKER_COMPOSE__
REDIS_DB=0

# ---- Milestone notifications ----
MILESTONE_ACTIVE_WINDOW_HOURS=72
MILESTONE_SCHEDULER_CRON=*/5 * * * *
MILESTONE_SCHEDULER_ENABLED=true
MILESTONE_SCHEDULER_BATCH_SIZE=30

# ---- LLM Gateway (LiteLLM-compatible proxy) ----
# Points the crypto-news publisher at the OpenAI-compatible gateway.
# Set real values via /opt/onchain-bot/.env on the droplet
# (never commit). The virtual key is scoped to specific model groups.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=opencode-zen/deepseek-v4-flash
