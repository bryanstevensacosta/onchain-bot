{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/jest-e2e.setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^telegram/sessions$": "<rootDir>/../../../node_modules/telegram/sessions/index.js",
    "^telegram/events$": "<rootDir>/../../../node_modules/telegram/events/index.js",
    "^telegram/(.*)$": "<rootDir>/../src/telegram/$1",
    "^shared/(.*)$": "<rootDir>/../src/shared/$1",
    "^discovery/(.*)$": "<rootDir>/../src/discovery/$1",
    "^chain/(.*)$": "<rootDir>/../src/chain/$1",
    "^token/(.*)$": "<rootDir>/../src/token/$1",
    "^kol/(.*)$": "<rootDir>/../src/kol/$1",
    "^dashboard/(.*)$": "<rootDir>/../src/dashboard/$1",
    "^settings/(.*)$": "<rootDir>/../src/settings/$1",
    "^data-provider/(.*)$": "<rootDir>/../src/data-provider/$1",
    "^health/(.*)$": "<rootDir>/../src/health/$1",
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@ingestion-service/media/(.*)$": "<rootDir>/../../ingestion-service/src/shared/media/$1",
    "^@ingestion-service/telegram/(.*)$": "<rootDir>/../../ingestion-service/src/shared/telegram/$1"
  }
}
