# =====================================================================
# threads-publisher Environment Variables (Fase 2 todo 9)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Ports: dev :4100 / staging :4101 / prod :4102.
# DBs: onchain_bot_threads[_staging] (C-DB-01 pattern: new apps own
# their logical DB; same server as the backend DB per env).
# =====================================================================

# Master switch for the threads-publisher service
THREADS_PUBLISHER_ENABLED=false

# Cutover flag (todo 11): false = backend legacy path serves traffic;
# true = this app serves traffic (dev -> staging -> prod)
USE_THREADS_PUBLISHER=false

# HTTP port for this service (dev 4100, staging 4101, prod 4102)
THREADS_PUBLISHER_PORT=4100

# Inbound API key for consumers (fail-open when empty, keyless dev)
THREADS_PUBLISHER_API_KEY=

# Owning ingestion-telegram instance this service reads from (dev default)
INGESTION_TELEGRAM_URL=http://localhost:3031

# Upstream key for the owning ingestion-telegram (P30 day-one rule:
# INGESTION_TELEGRAM_API_KEY sent as x-api-key on SSE + feed reads;
# empty = keyless). Ingestion side: INGESTION_API_KEY. Copy the value
# from the owning ingestion instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by threads-publisher)
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5446/onchain_bot_threads

# TypeORM auto-sync (dev/test only; staging/prod use migrations)
DATABASE_SYNCHRONIZE=true

# Redis connection (queue backend + cache)
REDIS_URL=redis://localhost:6393/0

# 3-flag control (C-FLAGS-01 mirror): matching, llm, publishing are
# independent. LLM generation ONLY runs when llmEnabled AND publishingEnabled.
MATCHING_ENABLED=false
LLM_ENABLED=false
PUBLISHING_ENABLED=false

# Queue bounds (backend parity): TTL 24h + max pending cap 100
QUEUE_TTL_HOURS=24
THREADS_MAX_QUEUE_DEPTH=100

# Publisher cadence (backend parity): drain every 10 minutes
THREADS_PUBLISH_CRON=*/10 * * * *
THREADS_DAILY_CAP=60

# Threads LLM model (env-configurable, DB-overridable via PATCH llm/config).
# Seeds ThreadsPromptTemplate threads-default + ThreadsLlmConfig default.
# Empty = provider-neutral fallback; set per env to the model your
# gateway serves. No provider model id is pinned in code.
THREADS_LLM_MODEL=

# Threads API (Meta): user id + long-lived token (60d, refreshed).
# NEVER commit real values. Token persists in threads_oauth_tokens (id=1).
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Threads publisher via the bots gateway (telegram-bots-gateway):
# THREADS_PUBLISH_MODE=direct (legacy direct adapter, deprecated) | dual
# (gateway + direct, compare, return direct — default, parity runs) |
# gateway (gateway vault ids only, fail-closed — cutover).
# BOTS_GATEWAY_URL: dev :4070 / staging :4071 / prod :4072.
# Secrets are DISTINCT per env; empty id+secret = keyless dev (gateway
# guard fails open). Token NEVER crosses to the gateway — vault botId only.
BOTS_GATEWAY_URL=http://localhost:4070
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
THREADS_PUBLISH_MODE=dual
THREADS_GATEWAY_BOT_ID=
