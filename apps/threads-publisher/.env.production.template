# =====================================================================
# threads-publisher PRODUCTION TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the production env file on the droplet.
# Copy this file to .env.production on the droplet and fill REAL values.
# OPERATOR-CONFIRM the destination path on first deploy (no
# threads-publisher deploy workflow exists yet; nothing copied anywhere).
# =====================================================================

NODE_ENV=production

# Master switch (adopted initial: OFF until cutover rehearsal, todo 11)
THREADS_PUBLISHER_ENABLED=false

# Cutover flag (adopted initial: OFF — backend legacy serves traffic
# until todo 11 flips dev -> staging -> prod)
USE_THREADS_PUBLISHER=false

# Production port (dev 4100 / staging 4101 / prod 4102)
THREADS_PUBLISHER_PORT=4102

# Inbound API key (REQUIRED in production)
THREADS_PUBLISHER_API_KEY=

# Owning ingestion-telegram instance (production, per-env model).
# Prod: host 127.0.0.1:3032 -> container :3031. Do NOT point prod
# at staging (:3033) or dev (:3031).
INGESTION_TELEGRAM_URL=http://onchain-bot-ingestion-telegram:3031

# Upstream key for the prod ingestion (P30: sent as x-api-key on SSE +
# feed reads). Prod side: INGESTION_API_KEY. Copy from the prod
# ingestion instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by threads-publisher, prod).
# C-DB-01 pattern: onchain_bot_threads on the SAME server as the
# prod backend DB. Fill with the prod postgres password on the
# droplet; NEVER commit.
# Example: postgres://onchain_bot:<PROD_PG_PASSWORD>@postgres:5432/onchain_bot_threads
DATABASE_URL=postgres://onchain_bot:<PROD_PG_PASSWORD>@postgres:5432/onchain_bot_threads

# Migrations on prod (never synchronize)
DATABASE_SYNCHRONIZE=false

# Redis (prod service name)
REDIS_URL=redis://redis:6379/0

# 3-flag control (prod starts OFF until cutover)
MATCHING_ENABLED=false
LLM_ENABLED=false
PUBLISHING_ENABLED=false

# Threads LLM model (env-configurable, DB-overridable; empty = fallback)
THREADS_LLM_MODEL=

# Threads API (prod placeholders — NEVER commit real values)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Bots gateway (prod :4072; DISTINCT secrets per env, NEVER commit)
BOTS_GATEWAY_URL=http://onchain-bot-ingestion-telegram:4072
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
THREADS_PUBLISH_MODE=dual
THREADS_GATEWAY_BOT_ID=
