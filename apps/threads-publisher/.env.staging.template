# =====================================================================
# threads-publisher STAGING TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the staging env file on the droplet.
# Copy this file to .env.staging on the droplet and fill REAL values.
# OPERATOR-CONFIRM the destination path on first deploy (no
# threads-publisher deploy workflow exists yet; nothing copied anywhere).
# =====================================================================

NODE_ENV=staging

# Master switch (adopted initial: on for staging dual-run/shadow)
THREADS_PUBLISHER_ENABLED=true

# Cutover flag (adopted initial: OFF — backend legacy serves traffic)
USE_THREADS_PUBLISHER=false

# Staging port: CONTAINER port (host mapping 4101:4100 lives in
# docker-compose.staging.yml; compose `environment:` wins over this file).
# Triplet: dev :4100 / staging host :4101 / prod host :4102.
THREADS_PUBLISHER_PORT=4100

# Inbound API key (fail-open when empty; set on staging)
THREADS_PUBLISHER_API_KEY=

# Owning ingestion-telegram instance (staging twin, per-env model).
# Twin: host 127.0.0.1:3033 -> container :3031. Do NOT point staging
# at localhost:3031 (dev) or the prod instance :3032.
INGESTION_TELEGRAM_URL=http://onchain-bot-ingestion-telegram-staging:3031

# Upstream key for the staging twin (P30: sent as x-api-key on SSE +
# feed reads; empty = keyless). Twin side: INGESTION_API_KEY. Copy
# from the twin ingestion instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by threads-publisher, staging).
# C-DB-01 pattern: onchain_bot_threads_staging on the SAME server as
# the staging backend DB. Fill with the staging postgres password on
# the droplet; NEVER commit.
# Example: postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_threads_staging
DATABASE_URL=postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_threads_staging

# Migrations on staging (never synchronize)
DATABASE_SYNCHRONIZE=false

# Redis (staging service name)
REDIS_URL=redis://redis:6379/0

# 3-flag control (staging starts shadow: matching on, publishing off)
MATCHING_ENABLED=true
LLM_ENABLED=false
PUBLISHING_ENABLED=false

# Threads LLM model (env-configurable, DB-overridable; empty = fallback)
THREADS_LLM_MODEL=

# Threads API (staging placeholders — NEVER commit real values)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Bots gateway (staging :4071; DISTINCT secrets per env, NEVER commit)
BOTS_GATEWAY_URL=http://onchain-bot-telegram-bots-gateway-staging:4071
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
THREADS_PUBLISH_MODE=dual
THREADS_GATEWAY_BOT_ID=
