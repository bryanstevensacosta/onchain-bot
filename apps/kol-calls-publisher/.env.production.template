# =====================================================================
# kol-calls-publisher PRODUCTION template - placeholders only, NEVER secrets
# =====================================================================
# Copy to .env.production ON THE SERVER, fill secrets by hand there, never commit.
# Ports: prod host :3062 -> container :3060.
# =====================================================================

NODE_ENV=production

KOL_CALLS_PUBLISHER_ENABLED=true

TEMPLATE_ORCHESTRATOR_ENABLED=false

# Upstream kol-calls prod
KOL_CALLS_URL=http://onchain-bot-kol-calls:3050
KOL_CALLS_API_KEY=

KOL_CALLS_PUBLISHER_API_KEY=

# DISTINCT per env (P24). Generate: openssl rand -hex 32. NEVER commit.
ENCRYPTION_KEY=

# SAME logical DB as kol-calls prod initially (P51, split later)
DATABASE_URL=postgres://onchain_bot:CHANGEME@postgres:5432/onchain_bot_kol_system

REDIS_URL=redis://redis:6379/0

KOL_CALLS_PUBLISHER_PORT=3060

KOL_CALLS_SYNC_ENABLED=false
KOL_CALLS_SYNC_INTERVAL_MS=60000
KOL_CALLS_SYNC_LIMIT=50

BOTS_GATEWAY_URL=http://onchain-bot-telegram-bots-gateway:4070
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
KOL_PUBLISH_MODE=gateway
PUBLISH_RATE_LIMIT_PER_MIN=30
