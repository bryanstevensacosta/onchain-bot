# =====================================================================
# kol-calls-publisher Environment Variables (P51 split from kol-system)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

# Master switch for the publisher service
KOL_CALLS_PUBLISHER_ENABLED=false

# Template orchestrator feature flag
TEMPLATE_ORCHESTRATOR_ENABLED=false

# Upstream kol-calls instance this service reads mentions+snapshots from
# (P51 contract: paginated, keyed, x-api-key). Dev default :3050.
KOL_CALLS_URL=http://localhost:3050

# Upstream key for kol-calls (sent as x-api-key on mentions/snapshots/
# rankings reads; empty = keyless). Copy from the owning kol-calls
# instance (KOL_SYSTEM_API_KEY) on deploy, NEVER commit.
KOL_CALLS_API_KEY=

# Inbound key for THIS service (fail-open when empty, keyless dev).
# Clients (frontend/ops) send it as x-api-key.
KOL_CALLS_PUBLISHER_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
# DISTINCT per env (P24). Same value family as kol-calls (shared catalog).
ENCRYPTION_KEY=

# Postgres connection — SAME logical DB as kol-calls initially (P51):
# dev points at the kol-system dev postgres (see docker-compose.yml).
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5435/onchain_bot_kol_system

# Redis connection (reuses kol-calls dev redis initially)
REDIS_URL=redis://localhost:6382/0

# HTTP port for this service (triplet 3060/3061/3062 dev/staging/prod)
KOL_CALLS_PUBLISHER_PORT=3060

# Sync knobs: pull mentions+snapshots from kol-calls on a cron
KOL_CALLS_SYNC_ENABLED=false
KOL_CALLS_SYNC_INTERVAL_MS=60000
KOL_CALLS_SYNC_LIMIT=50

# Market-data bridge note: enrichment lives in kol-calls; the publisher
# never calls market-data directly (scoring reads snapshot fields only).

# telegram-bots-gateway client (mirrors kol-calls todo 4):
# dev :4070, staging :4071, prod :4072. Empty id/secret = keyless dev.
BOTS_GATEWAY_URL=http://localhost:4070
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=

# Publish path: direct (legacy, deprecated) | dual (both legs + parity,
# returns direct) | gateway (cutover, fail-closed). Default dual.
KOL_PUBLISH_MODE=dual

# Fixed-window publish cap per caller+scope (429 over limit, pre-Telegram)
PUBLISH_RATE_LIMIT_PER_MIN=30
