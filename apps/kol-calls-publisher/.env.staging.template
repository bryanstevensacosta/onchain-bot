# =====================================================================
# kol-calls-publisher STAGING template - placeholders only, NEVER secrets
# =====================================================================
# Copy to .env.staging ON THE SERVER, fill secrets by hand there, never commit.
# Ports: staging host :3061 -> container :3060.
# =====================================================================

NODE_ENV=staging

KOL_CALLS_PUBLISHER_ENABLED=true

# Cutover task-16 (staging): orchestrator ON — publisher serves the VIP flow.
# Rollback: false (kill-switch, dashboard-only) in under 30 min per app.
TEMPLATE_ORCHESTRATOR_ENABLED=true

# Upstream kol-calls staging (staging net DNS)
KOL_CALLS_URL=http://onchain-bot-kol-calls-staging:3050
KOL_CALLS_API_KEY=

KOL_CALLS_PUBLISHER_API_KEY=

# DISTINCT per env (P24). Generate: openssl rand -hex 32. NEVER commit.
ENCRYPTION_KEY=

# SAME logical DB as kol-calls staging initially (P51, split later)
DATABASE_URL=postgres://onchain_bot:CHANGEME@postgres:5432/onchain_bot_kol_system_staging

REDIS_URL=redis://redis:6379/0

KOL_CALLS_PUBLISHER_PORT=3060

# Cutover task-16 (staging): sync ON — publisher scores upstream mentions.
KOL_CALLS_SYNC_ENABLED=true
KOL_CALLS_SYNC_INTERVAL_MS=60000
KOL_CALLS_SYNC_LIMIT=50

BOTS_GATEWAY_URL=http://onchain-bot-telegram-bots-gateway-staging:4071
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
KOL_PUBLISH_MODE=gateway
PUBLISH_RATE_LIMIT_PER_MIN=30
