# =====================================================================
# ai-ml Environment Variables (todo 0)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Ports: dev :4090 / staging host :4091 / prod host :4092 (verified
# free repo-wide 2026-09-26 — lsof + source grep zero hits).
# DBs: onchain_bot_ai_ml[_staging] (new apps own their logical DB;
# same server as the backend DB per env).
# =====================================================================

# Master switch for the ai-ml service
AI_ML_ENABLED=false

# HTTP port for this service (dev 4090, staging host 4091, prod 4092)
AI_ML_PORT=4090

# Bind address: loopback-only by default. Expose wider ONLY as an
# explicit operator decision (0.0.0.0 or the Tailscale IP on Oracle).
AI_ML_HOST=127.0.0.1

# Inbound API key for consumers (fail-open when empty, keyless dev)
AI_ML_API_KEY=

# Symmetric key (generate: openssl rand -hex 32, NEVER commit).
# REQUIRED on staging/prod (boot throws without it); pepper for the
# API-key HMAC store. Distinct per env.
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by ai-ml)
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5444/onchain_bot_ai_ml

# TypeORM auto-sync (dev/test only; staging/prod use migrations)
DATABASE_SYNCHRONIZE=true

# Redis connection (cache + rate-limiter windows)
REDIS_URL=redis://localhost:6391/0

# 3-flag mirror: ai-ml owns llm + publishing; matching lives in the
# consumer (feed-publisher/scheduling-posts). LLM generation ONLY runs
# when llmEnabled AND publishingEnabled.
LLM_ENABLED=false
PUBLISHING_ENABLED=false

# LLM gateway: mock mode for dev/test without provider cost.
# Gateway is the DEFAULT provider (OpenAI-compatible /v1); mock wins
# when USE_MOCK_AI=true. OpenAI direct is the fallback when only
# OPENAI_API_KEY is set. LLM_MODEL is the fallback when a template or
# playground draft does not pin a model.
USE_MOCK_AI=true
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_ATTEMPTS=3

# Embeddings (todo 2): single interface, model-per-call + LRU cache.
# EMBEDDING_MODEL is the OpenAI default (text-embedding-3-small);
# DEDUP_EMBEDDING_MODEL stays as a fallback alias (migration source).
# EMBEDDING_LOCAL_MODEL mirrors the backend local shape
# (Xenova/all-MiniLM-L6-v2, lazy @xenova/transformers load, OPTIONAL
# dep — missing dep is an explicit 503, never a hang).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_CACHE_MAX_ENTRIES=500
