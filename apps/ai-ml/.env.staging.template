REDIS_URL=redis://redis:6379/1
LLM_ENABLED=false
PUBLISHING_ENABLED=false
USE_MOCK_AI=true
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_ATTEMPTS=3
NODE_ENV=staging
