# ai-ml staging template — copy to .env.staging on the twin host.
# NEVER commit real values. Staging host port :4091 -> container :4090.
AI_ML_ENABLED=true
AI_ML_PORT=4090
AI_ML_HOST=0.0.0.0
AI_ML_API_KEY=
ENCRYPTION_KEY=
DATABASE_URL=postgres://onchain_bot:onchain_bot@postgres:5432/onchain_bot_ai_ml_staging
