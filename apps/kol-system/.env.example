# =====================================================================
# kol-system Environment Variables (skeleton, Tramo 1 todo 2)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

# Master switch for the kol-system service
KOL_SYSTEM_ENABLED=false

# Template orchestrator feature flag
TEMPLATE_ORCHESTRATOR_ENABLED=false

# Owning ingestion-telegram instance this service reads from (dev default)
INGESTION_TELEGRAM_URL=http://localhost:3031

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by kol-system)
DATABASE_URL=postgres://alpha_meta_token_scanner:alpha_meta_token_scanner@localhost:5432/alpha_meta_token_scanner_kol_system

# Redis connection
REDIS_URL=redis://localhost:6379/0

# HTTP port for this service
KOL_SYSTEM_PORT=3050
