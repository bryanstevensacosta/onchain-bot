NODE_ENV=production

# Master switch for the kol-system service
KOL_SYSTEM_ENABLED=

# Template orchestrator feature flag
TEMPLATE_ORCHESTRATOR_ENABLED=

# Owning ingestion-telegram instance (prod singleton)
INGESTION_TELEGRAM_URL=http://onchain-bot-ingestion-telegram:3031

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by kol-system, production)
DATABASE_URL=

# Redis connection (production)
REDIS_URL=

# HTTP port for this service
KOL_SYSTEM_PORT=3050
