# Backend API base URL
# Default: http://localhost:3030
VITE_API_BASE_URL=http://localhost:3030

# WebSocket URL
# Default: http://localhost:3030
VITE_WS_URL=http://localhost:3030

# Feed-publisher service base URL (Tramo 2, todo 9)
# Empty = same-origin /feed-api proxy (vite dev → :3040, staging :3041, prod :3042)
# Set to an absolute URL for direct service access (e.g. http://localhost:3041)
# FEED naming (not CONTENT) per the P35 content→feed rename
VITE_FEED_PUBLISHER_URL=

# Application environment
# Values: development | staging | production
# Default: development
# Note: In production, the LLM toggle button is hidden (LLM generation is always enabled)
VITE_APP_ENV=development
