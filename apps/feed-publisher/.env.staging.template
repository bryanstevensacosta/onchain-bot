# =====================================================================
# feed-publisher STAGING TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the staging env file on the droplet.
# Copy this file to .env.staging on the droplet and fill REAL values.
# Deploy mirror (same convention as kol-system .env.staging.template):
#   scp apps/feed-publisher/.env.staging OracleDroplet:/opt/onchain-bot-staging/apps/feed-publisher/.env.staging
# OPERATOR-CONFIRM the destination path on first deploy (no
# feed-publisher deploy workflow exists yet; nothing copied anywhere).
# =====================================================================

NODE_ENV=staging

# Master switch (adopted initial: on for staging dual-run/shadow)
FEED_PUBLISHER_ENABLED=true

# Cutover flag (adopted initial: OFF — backend legacy serves traffic)
USE_FEED_PUBLISHER=false

# Staging port: CONTAINER port (host mapping 3041:3040 lives in
# docker-compose.staging.yml; compose `environment:` wins over this file).
# Triplet: dev :3040 / staging host :3041 / prod host :3042.
FEED_PUBLISHER_PORT=3040

# Inbound API key (fail-open when empty; set on staging)
FEED_PUBLISHER_API_KEY=

# Owning ingestion-telegram instance (staging twin, per-env model).
# Twin: host 127.0.0.1:3033 -> container :3031. Do NOT point staging
# at localhost:3031 (dev) or the prod instance :3032.
INGESTION_TELEGRAM_URL=http://onchain-bot-ingestion-telegram-staging:3031

# Upstream key for the staging twin (P30: sent as x-api-key on SSE +
# feed reads; empty = keyless). Twin side: INGESTION_API_KEY. Copy
# from the twin ingestion instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by feed-publisher, staging).
# C-DB-01: onchain_bot_feed_publisher_staging on the SAME server as
# the staging backend DB. Fill with the staging postgres password on
# the droplet; NEVER commit.
# Example: postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_feed_publisher_staging
DATABASE_URL=postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_feed_publisher_staging

# Migrations on staging (never synchronize)
DATABASE_SYNCHRONIZE=false

# Redis (staging service name)
REDIS_URL=redis://redis:6379/1

# 3-flag control (C-FLAGS-01, adopted initial: all OFF on staging)
MATCHING_ENABLED=false
LLM_ENABLED=false
PUBLISHING_ENABLED=false
MATCHING_CRON_ENABLED=false

# Queue bounds
QUEUE_TTL_HOURS=24
QUEUE_MAX_PENDING=500

# Dedup cascade (adopted initial: OFF)
DEDUP_ENABLED=false

# LLM gateway (adopted initial: mock, no provider cost on staging)
USE_MOCK_AI=true
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_ATTEMPTS=3

# Scheduling rotation + media library (todo 6, P36 naming, P38 per-target;
# adopted initial: OFF on staging — flags below are inert until enabled)
ADS_ENABLED=false
ADS_ROTATION_EVERY_N=5
SCHEDULING_CRON_ENABLED=false
SCHEDULING_MIN_MINUTES_BETWEEN_ADS=30
SCHEDULING_TELEGRAM_PUBLISH_DELAY_MS=60000
SCHEDULING_TELEGRAM_DAILY_CAP=20
SCHEDULING_THREADS_PUBLISH_DELAY_MS=60000
SCHEDULING_THREADS_DAILY_CAP=20

# Threads skeleton cron (todo 8, C1 — HTTP stays 501 until the v2 contract;
# adopted initial: OFF on staging)
THREADS_CRON_ENABLED=false

# Scheduling media storage root (empty = <cwd>/uploads)
FEED_PUBLISHER_UPLOADS_ROOT=

# Telegram publishers (staging bot tokens, NEVER commit)
CRYPTO_NEWS_BOT_TOKEN=
THREADS_BOT_TOKEN=
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
CRYPTO_NEWS_RATE_LIMIT_PER_MINUTE=
THREADS_RATE_LIMIT_PER_MINUTE=
CRYPTO_NEWS_OUTPUT_CHANNEL=
THREADS_OUTPUT_CHANNEL=
