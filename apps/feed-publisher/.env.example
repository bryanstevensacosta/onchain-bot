# =====================================================================
# feed-publisher Environment Variables (skeleton, Tramo 2 todo 1)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Ports: dev :3040 / staging :3041 / prod :3042.
# DBs: onchain_bot_feed_publisher[_staging] (C-DB-01: new apps own
# their logical DB; same server as the backend DB per env).
# =====================================================================

# Master switch for the feed-publisher service
FEED_PUBLISHER_ENABLED=false

# Cutover flag (todo 11): false = backend legacy path serves traffic;
# true = this app serves traffic (dev -> staging -> prod, day 1/3/7)
USE_FEED_PUBLISHER=false

# HTTP port for this service (dev 3040, staging 3041, prod 3042)
FEED_PUBLISHER_PORT=3040

# Inbound API key for consumers (fail-open when empty, keyless dev)
FEED_PUBLISHER_API_KEY=

# Owning ingestion-telegram instance this service reads from (dev default)
INGESTION_TELEGRAM_URL=http://localhost:3031

# Upstream key for the owning ingestion-telegram (P30 day-one rule:
# INGESTION_TELEGRAM_API_KEY sent as x-api-key on SSE + feed reads;
# empty = keyless). Ingestion side: INGESTION_API_KEY. Copy the value
# from the owning ingestion instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by feed-publisher, C-DB-01)
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5436/onchain_bot_feed_publisher

# TypeORM auto-sync (dev/test only; staging/prod use migrations)
DATABASE_SYNCHRONIZE=true

# Redis connection (BullMQ queue backend + cache)
REDIS_URL=redis://localhost:6383/0

# 3-flag control (C-FLAGS-01): matching, llm, publishing are independent.
# LLM generation ONLY runs when llmEnabled AND publishingEnabled.
MATCHING_ENABLED=false
LLM_ENABLED=false
PUBLISHING_ENABLED=false

# Matching cron (enqueue pass every 1 min when true)
MATCHING_CRON_ENABLED=false

# Queue bounds (todo 4): TTL 24h + max pending cap
QUEUE_TTL_HOURS=24
QUEUE_MAX_PENDING=500

# Deduplication cascade exact -> content -> semantic (fail-open, todo 4)
DEDUP_ENABLED=false

# LLM gateway (todo 5): mock mode for dev/test without provider cost.
# Gateway is the DEFAULT provider (OpenAI-compatible /v1); mock wins
# when USE_MOCK_AI=true. LLM_MODEL is the fallback when a template or
# playground draft does not pin a model.
USE_MOCK_AI=true
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_ATTEMPTS=3

# Scheduling rotation + media library (todo 6, P36 naming, P38 per-target):
# each delivery target paces independently (own wait + own daily cutoff).
# ADS_* stays as the legacy alias pair (rotation master + cadence).
ADS_ENABLED=false
ADS_ROTATION_EVERY_N=5
SCHEDULING_CRON_ENABLED=true
SCHEDULING_MIN_MINUTES_BETWEEN_ADS=30
SCHEDULING_TELEGRAM_PUBLISH_DELAY_MS=60000
SCHEDULING_TELEGRAM_DAILY_CAP=20
SCHEDULING_THREADS_PUBLISH_DELAY_MS=60000
SCHEDULING_THREADS_DAILY_CAP=20

# Scheduling media storage root (Opcion B: app-root uploads).
# Defaults to <cwd>/uploads when empty.
FEED_PUBLISHER_UPLOADS_ROOT=

# Telegram publishers (todo 7): per-bot tokens + shared rate limit.
# P10: NO KOL/vip-calls bot here — crypto + threads only.
CRYPTO_NEWS_BOT_TOKEN=
THREADS_BOT_TOKEN=
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
