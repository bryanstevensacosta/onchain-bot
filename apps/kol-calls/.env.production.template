# =====================================================================
# kol-calls PRODUCTION TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the production env file on the droplet.
# Copy this file to .env.production on the droplet and fill REAL values.
# This file is committed with placeholders/adopted defaults ONLY (NO secrets).
# Deploy mirror (backend prod env lives at
# /opt/onchain-bot/apps/backend/.env.production — deploy.yml:268; rsync
# excludes .env* — deploy.yml:257 — so kol-calls mirrors at):
#   scp apps/kol-calls/.env.production OracleDroplet:/opt/onchain-bot/apps/kol-calls/.env.production
#   ssh OracleDroplet 'chmod 600 /opt/onchain-bot/apps/kol-calls/.env.production'
# OPERATOR-CONFIRM the destination path on first deploy (no kol-calls
# deploy workflow exists yet; nothing has been copied anywhere).
# =====================================================================

NODE_ENV=production

# Master switch for the kol-calls service (adopted initial: on;
# kill-switch stays available per C-FLAGS-01 — set false to freeze)
KOL_CALLS_ENABLED=true

# Template orchestrator feature flag (adopted initial: OFF — enable only
# at cutover after the 14-day staging gate + rollback rehearsal)
TEMPLATE_ORCHESTRATOR_ENABLED=false

# Tracking cron (kol_window_stats rebuild, 1 min when true; adopted initial: on)
TRACKING_CRON_ENABLED=true

# Owning ingestion-telegram instance (prod singleton, per-env model).
# Backend prod pins the same DNS via compose environment
# (apps/backend/docker-compose.prod.yml:119). Do NOT point prod at the
# staging twin :3033 or dev localhost:3031.
INGESTION_TELEGRAM_URL=http://onchain-bot-ingestion-telegram:3031

# Upstream key for the prod ingestion-telegram (backend-mirror:
# INGESTION_TELEGRAM_API_KEY sent as x-api-key; empty = keyless).
# Ingestion side: INGESTION_API_KEY. Copy from the prod ingestion
# instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit).
# MUST differ per env (P24) — never reuse the staging value.
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by kol-calls, production).
# C-DB-01: onchain_bot_kol_system on the SAME server as the prod backend DB
# (pre-rename name UNTOUCHED until .omo/runbooks/rename-onchain-bot-db.md
# executes; user/role below is the TARGET state). Same POSTGRES_USER as backend per
# server (suggestion S1, see evidence task-dbs-envs.log).
# Fill with the prod postgres password on the droplet; NEVER commit.
# Example: postgres://onchain_bot:<PROD_PG_PASSWORD>@postgres:5432/onchain_bot_kol_system
DATABASE_URL=

# Redis connection (production single-string form; must match the redis
# service in the prod compose — prod redis REQUIRES auth
# (docker-compose.prod.yml:55 --requirepass). Fill the password on the
# droplet; NEVER commit.
# Example: redis://:PROD_REDIS_PASSWORD@redis:6379/0
REDIS_URL=

# Optional API key for feed consumers (fail-open when empty).
# Generate per env (`openssl rand -hex 32`), store ONLY on the droplet
# (NEVER commit). Distinct from the staging value.
KOL_CALLS_API_KEY=

# HTTP port for this service (container port; host mapping 3052:3050
# lives in the prod compose — keep at 3050)
KOL_CALLS_PORT=3050

# Market-data bridge (P7; resilient bridge todo 5, G-17): false =
# local-cascade leaf (staged rollout — flip to true ONLY after staging
# cutover + prod SLO; dev already runs true). URL pins the prod
# market-data host port (todo 8 deploy; operator: confirm on droplet).
USE_DATA_SERVICE_API=false
MARKET_DATA_URL=http://localhost:4002
MARKET_DATA_TIMEOUT_MS=2000

# Inbound key of the prod market-data service (sent as x-api-key;
# empty = keyless). Copy from the prod market-data instance env on
# deploy, NEVER commit.
MARKET_DATA_API_KEY=

# TypeORM mode (inert today — no TypeORM wired, in-memory repos only;
# persistence todo owns data-source.ts + migrations). Pin false per
# C-DB-01 (synchronize:false, migrationsRun:false outside dev/test).
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# telegram-bots-gateway client (todo 4, prod cutover): HMAC-signed sends
# to the prod gateway :4072. Fill id/secret from the prod gateway env
# (BOTS_GATEWAY_CLIENTS on the droplet), NEVER commit.
BOTS_GATEWAY_URL=http://localhost:4072
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
KOL_PUBLISH_MODE=gateway
