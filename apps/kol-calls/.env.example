# =====================================================================
# kol-calls Environment Variables (skeleton, Tramo 1 todo 2; renamed from kol-system)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

# Master switch for the kol-calls service
KOL_CALLS_ENABLED=false

# Template orchestrator feature flag
TEMPLATE_ORCHESTRATOR_ENABLED=false

# Owning ingestion-telegram instance this service reads from (dev default)
INGESTION_TELEGRAM_URL=http://localhost:3031

# Upstream key for the owning ingestion-telegram (backend-mirror:
# INGESTION_TELEGRAM_API_KEY sent as x-api-key on SSE + feed reads;
# empty = keyless). Ingestion side: INGESTION_API_KEY. Copy the value
# from the owning ingestion instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by kol-calls, C-DB-01: onchain_bot_* solo apps nuevas)
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5432/onchain_bot_kol_system

# Redis connection
REDIS_URL=redis://localhost:6379/0

# HTTP port for this service
KOL_CALLS_PORT=3050

# Market-data bridge (todo 8, P7; resilient bridge todo 5, G-17):
# false = local-cascade leaf (default — no market-data calls, C-DATA-01);
# true = HTTP market-data service primary + local fallback.
# Staged rollout: dev flips first (see .env.development), staging/prod
# only after the 24h staging SLO lands. URL is per env (:4000 dev,
# :4001 staging host, :4002 prod).
USE_DATA_SERVICE_API=false

# Base URL + per-request timeout for the HTTP market-data leaf
# (only read when USE_DATA_SERVICE_API=true)
MARKET_DATA_URL=http://localhost:4000
MARKET_DATA_TIMEOUT_MS=2000

# Inbound key of the market-data service (sent as x-api-key;
# empty = keyless dev, fail-open). Copy from the owning market-data
# instance env on deploy, NEVER commit.
MARKET_DATA_API_KEY=

# telegram-bots-gateway client (todo 4): HMAC-signed sends to the gateway
# vault (dev :4070, staging :4071, prod :4072). Empty id/secret = keyless
# dev (gateway guard fails open); DISTINCT secrets per env, NEVER commit.
BOTS_GATEWAY_URL=http://localhost:4070
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=

# Publish path: direct (legacy, deprecated) | dual (both legs + parity,
# returns direct) | gateway (cutover, fail-closed). Default dual.
KOL_PUBLISH_MODE=dual
