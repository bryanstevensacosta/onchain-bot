# =====================================================================
# kol-calls STAGING TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the staging env file on the droplet.
# Copy this file to .env.staging on the droplet and fill REAL values.
# This file is committed EMPTY so reviewers can see the schema.
# Deploy mirror (verified against backend staging deploy
# .github/workflows/deploy-staging.yml:339 — env lives at
# /opt/onchain-bot-staging/apps/backend/.env.staging; rsync excludes .env*,
# deploy-staging.yml:326 — so kol-calls mirrors at):
#   scp apps/kol-calls/.env.staging OracleDroplet:/opt/onchain-bot-staging/apps/kol-calls/.env.staging
# OPERATOR-CONFIRM the destination path on first deploy (no kol-calls
# deploy workflow exists yet; nothing has been copied anywhere).
# =====================================================================

NODE_ENV=staging

# Master switch for the kol-calls service (adopted initial: on for staging dual-run/shadow)
KOL_CALLS_ENABLED=true

# Template orchestrator feature flag (adopted initial: OFF — dashboard/rankings only until cutover rehearsal)
TEMPLATE_ORCHESTRATOR_ENABLED=false

# Tracking cron (kol_window_stats rebuild, 1 min when true; adopted initial: on)
TRACKING_CRON_ENABLED=true

# Owning ingestion-telegram instance (staging twin, per-env model).
# Verified: backend staging pins the same DNS via compose environment
# (apps/backend/docker-compose.staging.yml:98) and documents it in
# apps/backend/.env.staging.template:76. Twin: host 127.0.0.1:3033 →
# container :3031 (apps/backend/docker-compose.staging-ingestion.yml:31).
# Do NOT point staging at localhost:3031 (dev) or the prod singleton :3032.
INGESTION_TELEGRAM_URL=http://onchain-bot-ingestion-telegram-staging:3031

# Upstream key for the staging twin (backend-mirror:
# INGESTION_TELEGRAM_API_KEY sent as x-api-key; empty = keyless).
# Twin side: INGESTION_API_KEY. Copy from the twin ingestion
# instance env on deploy, NEVER commit.
INGESTION_TELEGRAM_API_KEY=

# Symmetric encryption key (generate: openssl rand -hex 32, NEVER commit)
ENCRYPTION_KEY=

# Postgres connection (logical DB owned by kol-calls, staging).
# C-DB-01: onchain_bot_kol_system_staging on the SAME server as the staging
# backend DB (pre-rename name UNTOUCHED until .omo/runbooks/rename-onchain-bot-db.md
# executes; user/role below is the TARGET state). Same POSTGRES_USER
# as backend per server (suggestion S1, see evidence task-dbs-envs.log).
# Fill with the staging postgres password on the droplet; NEVER commit.
# Example: postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_kol_system_staging
DATABASE_URL=

# Redis connection (staging single-string form; must match the redis
# service in docker-compose.staging.yml — default redis://redis:6379/0).
# Staging redis currently runs WITHOUT auth (verified 2026-09-25, see
# evidence task-dbs-envs.log suggestion S2). If the operator enables
# REDIS_PASSWORD later, use: redis://:PASSWORD@redis:6379/0
REDIS_URL=redis://redis:6379/0

# Optional API key for feed consumers (fail-open when empty).
# Staging value: generate per env (`openssl rand -hex 32`), store ONLY on the
# droplet + evidence log (NEVER commit). A fresh staging value was generated
# 2026-09-25 — see .omo/evidence/task-dbs-envs.log (operator: copy from there
# on first deploy, then rotate at will).
KOL_CALLS_API_KEY=

# HTTP port for this service (container port; host mapping 3051:3050
# lives in docker-compose.staging.yml — keep at 3050)
KOL_CALLS_PORT=3050

# Market-data bridge (P7; resilient bridge todo 5, G-17): false =
# local-cascade leaf (staged rollout — flip to true ONLY after the 24h
# staging SLO lands; dev already runs true). URL pins the staging
# market-data host port (todo 8 deploy; operator: confirm on droplet).
USE_DATA_SERVICE_API=false
MARKET_DATA_URL=http://localhost:4001
MARKET_DATA_TIMEOUT_MS=2000

# Inbound key of the staging market-data service (sent as x-api-key;
# empty = keyless). Copy from the staging market-data instance env on
# deploy, NEVER commit.
MARKET_DATA_API_KEY=

# TypeORM mode (inert today — no TypeORM wired, in-memory repos only;
# persistence todo owns data-source.ts + migrations). Pin false per
# C-DB-01 (synchronize:false, migrationsRun:false outside dev/test).
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# telegram-bots-gateway client (todo 4, staging cutover): HMAC-signed sends
# to the staging gateway :4071. Fill id/secret from the staging gateway env
# (BOTS_GATEWAY_CLIENTS on the droplet), NEVER commit.
BOTS_GATEWAY_URL=http://localhost:4071
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=
KOL_PUBLISH_MODE=gateway
