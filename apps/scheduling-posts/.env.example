# scheduling-posts env (todos 1-2, sessions-scheduler contract P42/P50/P52)
# Copy to .env (gitignored) and fill secrets. NEVER commit real secrets.

NODE_ENV=development

# Master switch (fire cron runs only when true AND SCHEDULING_CRON_ENABLED=true)
SCHEDULING_POSTS_ENABLED=false

# Triplet: dev :4080, staging :4081, prod :4082
SCHEDULING_POSTS_PORT=4080

# Inbound x-api-key (contract §5; fail-open when empty = keyless dev).
# DISTINCT per env. Health /api/health is the ONLY keyless route.
SCHEDULING_POSTS_API_KEY=

# Own logical DB (C-DB-01): onchain_bot_scheduling[_staging] on the
# shared server. Dev pg :5442 (next free repo-wide; feed staging
# DRY-RUN claims :5437, market dev :5438, dexter dev :5440).
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5442/onchain_bot_scheduling
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Media library root (permanent retention — no janitor deletes here)
SCHEDULING_POSTS_UPLOADS_ROOT=./uploads
# Public base for gateway photo/media_group URLs (Bot API fetches from
# here; empty = media posts fail MEDIA_MISSING instead of half-sending)
SCHEDULING_MEDIA_PUBLIC_BASE_URL=

# Rotation pacing (P38 per-target delay+caps; DB row wins when set)
SCHEDULING_TELEGRAM_PUBLISH_DELAY_MS=60000
SCHEDULING_TELEGRAM_DAILY_CAP=20
SCHEDULING_THREADS_PUBLISH_DELAY_MS=60000
SCHEDULING_THREADS_DAILY_CAP=20
SCHEDULING_CRON_ENABLED=true

# Contract fire tick + per-session burst guard (429, never burns keys)
PUBLISH_RATE_LIMIT_PER_MIN=10

# Session bindings seed (JSON; HTTP session lookup is the cutover
# follow-up). Empty = P38-ter 409 NO_ACTIVE_TARGET (dashboard-only).
# Shape: [{ sessionId, active, bindings: [{ bindingId, target, botId,
# defaultChatId, botVerified, publishDelayMs, dailyCap }] }]
SCHEDULING_SESSION_BINDINGS=

# Terminal result callbacks scheduler → sessions (contract §4,
# at-least-once). Empty URL = log-only (single-app dev).
SESSION_CALLBACK_URL=
SESSION_CALLBACK_API_KEY=

# telegram-bots-gateway (P42: ONLY transport; no Bot API leg exists).
# Triplet :4070/:4071/:4072. DISTINCT client secrets per env.
BOTS_GATEWAY_URL=http://localhost:4070
BOTS_GATEWAY_CLIENT_ID=
BOTS_GATEWAY_CLIENT_SECRET=

# Rotation rotation-catalog legacy channels (pending session bindings)
CRYPTO_NEWS_OUTPUT_CHANNEL=
THREADS_OUTPUT_CHANNEL=
