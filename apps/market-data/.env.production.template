# =====================================================================
# market-data PRODUCTION TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the production env file on the droplet.
# Copy this file to .env.production on the droplet and fill REAL values.
# Destination: /opt/onchain-bot/apps/market-data/.env.production — the
# file is operator-owned, excluded from the deploy rsync (`.env*`, so it
# is neither synced nor deleted) and NEVER committed. Its presence is
# asserted by `.github/workflows/deploy-market-data-prod.yml` (DORMANT
# until the Wave 4 owner gate) before any mutation.
# =====================================================================

NODE_ENV=production

# Master switch (adopted initial: OFF until cutover rehearsal, todo 8)
MARKET_DATA_ENABLED=false

# Cutover flag (adopted initial: OFF — backend local cascade serves traffic
# until todo 8 flips dev -> staging -> prod)
USE_DATA_SERVICE_API=false

# Production port: CONTAINER port (src/main.ts reads
# MARKET_DATA_PORT ?? 4000). Host mapping 4002:4000 lives in
# docker-compose.prod.yml; compose `environment:` wins over this file.
# Triplet: dev :4000 / staging host :4001 / prod host :4002.
MARKET_DATA_PORT=4000

# Bind address (P46): container default so the published host port is
# reachable (loopback-in-container is unreachable via port mapping).
# Do NOT pin 127.0.0.1 inside the container.
MARKET_DATA_HOST=0.0.0.0

# Inbound API key (REQUIRED in production)
MARKET_DATA_API_KEY=

# Postgres connection (logical DB owned by market-data, prod).
# C-DB-01: onchain_bot_market_data on the SAME server as the
# prod backend DB. Fill with the prod postgres password on the
# droplet; NEVER commit.
# UNIQUE-HOST RULE: host = the unique container name
# (onchain-bot-market-data-postgres-prod); the bare `postgres` alias is
# ambiguous on the shared `onchain-bot-net` (several containers claim it
# — Docker round-robins; dexter run 39126203303 hit the wrong server).
# NOTE: the compose `environment:` block pins DATABASE_URL itself and
# wins over this file; this line is the record for non-compose runs and
# must stay in sync with docker-compose.prod.yml + the workflow one-off
# `-e DATABASE_URL` (credential policy: one coordinated change).
DATABASE_URL=postgres://onchain_bot:<PROD_PG_PASSWORD>@onchain-bot-market-data-postgres-prod:5432/onchain_bot_market_data

# TypeORM gate (isDatabaseEnabled reads exactly "true").
# docker-compose also pins DATABASE_ENABLED: "true" in its
# `environment:` block, which wins over this file; kept here for
# non-compose runs.
DATABASE_ENABLED=true

# Migrations on prod (never synchronize)
DATABASE_SYNCHRONIZE=false

# Redis (unique container-name host — same Docker DNS alias-collision
# class as DATABASE_URL; the shared prod network has several `redis`
# aliases too). Index /1 mirrors the market-data staging stack fragment.
REDIS_URL=redis://onchain-bot-market-data-redis-prod:6379/1

# Provider API keys (provider-keys wire — fill on the droplet, NEVER
# commit; empty = skip-without-key, adapter returns null, never throws)
BIRDEYE_API_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL_MAINNET=
HELIUS_RPC_URL_DEVNET=
MORALIS_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
ALCHEMY_API_KEY=
MOBULA_API_KEY=
PUMPDEV_API_KEY=
PUMPDEV_WALLET_PUBLIC=
PUMPDEV_WALLET_PRIVATE=
FLUXRPC_API_KEY=
FLUXRPC_RPC=
FLUXRPC_WS=
