# =====================================================================
# market-data Environment Variables (skeleton, Tramo 3 todo 1, Variante A)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Ports: dev :4000 / staging host :4001 / prod :4002.
# DBs: market_data_db[_staging] (C-DB-01: new apps own
# their logical DB; same server as the backend DB per env).
# =====================================================================

# Master switch for the market-data service
MARKET_DATA_ENABLED=false

# Cutover flag (todo 5/8): false = backend local cascade serves traffic;
# true = consumers use this app over HTTP (dev -> staging -> prod)
USE_DATA_SERVICE_API=false

# HTTP port for this service (dev 4000, staging host 4001, prod 4002)
MARKET_DATA_PORT=4000

# Bind address (P46): loopback-only by default. Expose wider ONLY as an
# explicit operator decision (0.0.0.0 or the Tailscale IP on Oracle).
MARKET_DATA_HOST=127.0.0.1

# Inbound API key for consumers (fail-open when empty, keyless dev;
# P30 day-one rule: x-api-key contract from setup)
MARKET_DATA_API_KEY=

# Postgres connection (logical DB owned by market-data, C-DB-01)
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5432/market_data_db

# TypeORM auto-sync (dev/test only; staging/prod use migrations)
DATABASE_SYNCHRONIZE=true

# Redis connection (cache backend + rate-limiter windows)
REDIS_URL=redis://localhost:6385/0

# Stream driver (todo 11, P49): memory (default, deterministic, zero
# deps) or ccxt (real ccxt.pro WS; needs the optional ccxt.pro peer +
# credentials + network — operator-gated, never in CI)
MARKET_DATA_STREAM_DRIVER=memory

# Exchange allowlist for stream subscribes (todo 11, P49; REST ccxt
# adapter P48 stays pending — this gates the WS side only)
MARKET_DATA_STREAM_EXCHANGES=binance,coinbase,kraken

# Exchange allowlist for the ccxt REST adapter (todo 16, P48):
# tickers/OHLCV resolve against defaultExchange (first entry).
# `ccxt` is an optional peer — unset/absent resolves to null, fail-open.
MARKET_DATA_CCXT_EXCHANGES=binance,coinbase,kraken

# Chain-logo store (chain-logo resolver): directory for the fetch-once
# uploads/chain-logo/<chain>.png files. Defaults to
# <app-root>/uploads/chain-logo when unset (tests pin a tmpdir).
CHAIN_LOGO_DIR=

# Provider API keys (provider-keys wire): each keyed adapter resolves its
# key from the `app.*` config namespace (see
# src/shared/infrastructure/config/app.config.ts). Empty = skip-without-key
# (adapter returns null, never throws; zero-cost cascade never spends).
BIRDEYE_API_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL_MAINNET=
HELIUS_RPC_URL_DEVNET=
MORALIS_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
ALCHEMY_API_KEY=
# dRPC free tier (dexter plan todo 24): owner creates a free key at
# https://drpc.org and sets it here. Empty = dRPC tier skipped
# silently (Alchemy + public tiers still serve). Never commit real keys.
DRPC_API_KEY=
# Chainstack free-B tier (dexter plan todo 30a): owner creates a free
# key at https://chainstack.com and sets it here. Empty = Chainstack
# tier skipped silently (Alchemy + dRPC + public tiers still serve).
# EVM hosts pinned in `alchemy.chains.ts` (`CHAINSTACK_EVM_HOSTS`,
# `*`-rows extrapolated); Solana
# `https://solana-mainnet.core.chainstack.com/<key>`. Never commit keys.
CHAINSTACK_API_KEY=
# Shyft free-B tier, Solana-only (dexter plan todo 30a): owner creates
# a free key at https://shyft.to and sets it here. Empty = Shyft tier
# skipped silently. Endpoint `https://rpc.shyft.to/?api_key=<key>`.
# Index/holders legs are carved out (never sent to Shyft). Never commit keys.
SHYFT_API_KEY=
MOBULA_API_KEY=
PUMPDEV_API_KEY=
PUMPDEV_WALLET_PUBLIC=
PUMPDEV_WALLET_PRIVATE=
FLUXRPC_API_KEY=
FLUXRPC_RPC=
FLUXRPC_WS=
