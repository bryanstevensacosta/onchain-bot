# =====================================================================
# market-data Environment Variables (skeleton, Tramo 3 todo 1, Variante A)
# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Ports: dev :4000 / staging host :4001 / prod :4002.
# DBs: onchain_bot_market_data[_staging] (C-DB-01: new apps own
# their logical DB; same server as the backend DB per env).
# =====================================================================

# Master switch for the market-data service
MARKET_DATA_ENABLED=false

# Cutover flag (todo 5/8): false = backend local cascade serves traffic;
# true = consumers use this app over HTTP (dev -> staging -> prod)
USE_DATA_SERVICE_API=false

# HTTP port for this service (dev 4000, staging host 4001, prod 4002)
MARKET_DATA_PORT=4000

# Bind address (P46): loopback-only by default. Expose wider ONLY as an
# explicit operator decision (0.0.0.0 or the Tailscale IP on Oracle).
MARKET_DATA_HOST=127.0.0.1

# Inbound API key for consumers (fail-open when empty, keyless dev;
# P30 day-one rule: x-api-key contract from setup)
MARKET_DATA_API_KEY=

# Postgres connection (logical DB owned by market-data, C-DB-01)
DATABASE_URL=postgres://onchain_bot:onchain_bot@localhost:5438/onchain_bot_market_data

# TypeORM auto-sync (dev/test only; staging/prod use migrations)
DATABASE_SYNCHRONIZE=true

# Redis connection (cache backend + rate-limiter windows)
REDIS_URL=redis://localhost:6385/0

# Stream driver (todo 11, P49): memory (default, deterministic, zero
# deps) or ccxt (real ccxt.pro WS; needs the optional ccxt.pro peer +
# credentials + network — operator-gated, never in CI)
MARKET_DATA_STREAM_DRIVER=memory

# Exchange allowlist for stream subscribes (todo 11, P49; REST ccxt
# adapter P48 stays pending — this gates the WS side only)
MARKET_DATA_STREAM_EXCHANGES=binance,coinbase,kraken
