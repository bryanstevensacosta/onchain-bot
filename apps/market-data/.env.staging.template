# =====================================================================
# market-data STAGING TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =====================================================================
# This is a TEMPLATE for the staging env file on the droplet.
# Copy this file to .env.staging on the droplet and fill REAL values.
# OPERATOR-CONFIRM the destination path on first deploy (no
# market-data deploy workflow exists yet; nothing copied anywhere).
# =====================================================================

NODE_ENV=staging

# Master switch (adopted initial: on for staging dual-run/shadow)
MARKET_DATA_ENABLED=true

# Cutover flag (adopted initial: OFF — backend local cascade serves traffic
# until todo 8 flips dev -> staging -> prod)
USE_DATA_SERVICE_API=false

# Staging port: CONTAINER port (host mapping 4001:4000 lives in
# docker-compose.staging.yml; compose `environment:` wins over this file).
# Triplet: dev :4000 / staging host :4001 / prod :4002.
MARKET_DATA_PORT=4000

# Inbound API key (fail-open when empty; set on staging)
MARKET_DATA_API_KEY=

# Postgres connection (logical DB owned by market-data, staging).
# C-DB-01: onchain_bot_market_data_staging on the SAME server as
# the staging backend DB. Fill with the staging postgres password on
# the droplet; NEVER commit.
# Example: postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_market_data_staging
DATABASE_URL=postgres://onchain_bot:<STAGING_PG_PASSWORD>@postgres:5432/onchain_bot_market_data_staging

# Migrations on staging (never synchronize)
DATABASE_SYNCHRONIZE=false

# Redis (staging service name)
REDIS_URL=redis://redis:6379/1

# Provider API keys (provider-keys wire — fill on the droplet, NEVER
# commit; empty = skip-without-key, adapter returns null, never throws)
BIRDEYE_API_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL_MAINNET=
HELIUS_RPC_URL_DEVNET=
MORALIS_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
ALCHEMY_API_KEY=
MOBULA_API_KEY=
PUMPDEV_API_KEY=
PUMPDEV_WALLET_PUBLIC=
PUMPDEV_WALLET_PRIVATE=
FLUXRPC_API_KEY=
FLUXRPC_RPC=
FLUXRPC_WS=
