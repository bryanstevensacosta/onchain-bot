{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git fetch *": "allow",
      "gh run view": "allow",
      "gh run view *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow"
    }
  }
}
