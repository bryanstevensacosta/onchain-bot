# =====================================================================
# ENVIRONMENT VARIABLES REQUIRED BY Alpha Meta Token Scanner
# =====================================================================
# Copy this file to `.env` and fill in your real values.
# The app loads all vars from `.env` via @nestjs/config.
# =====================================================================

# ---- Application ----
NODE_ENV=development
PORT=3000


# ---- CoinMarketCap -----
COINMARKETCAP_API_KEY=


# ---- CoinGecko -----
COINGECKO_API_KEY=


# ---- Alchemy (EVM RPC provider) ----
ALCHEMY_API_KEY=


# ---- Birdeye (Token market data) ----
BIRDEYE_API_KEY=


# ---- FluxRPC ----
FLUXRPC_API_KEY=
FLUXRPC_RPC=
FLUXRPC_WS=


# ---- Helius (Solana RPC + Enhanced APIs) ----
HELIUS_API_KEY=

HELIUS_RPC_URL_MAINNET=
HELIUS_GATEKEEPER_RPC_URL_MAINNET=
HELIUS_WS_MAINNET=
HELIUS_PARSE_SOLANA_TRANSACTION_MAINNET=
HELIUS_PARSE_SOLANA_TRANSACTION_HISTORY_MAINNET=

HELIUS_RPC_URL_DEVNET=
HELIUS_WS_DEVNET=
HELIUS_PARSE_SOLANA_TRANSACTION_DEVNET=
HELIUS_PARSE_SOLANA_TRANSACTION_HISTORY_DEVNET=


# ---- Mobula ----
MOBULA_API_KEY=


# ---- Moralis ----
MORALIS_API_KEY=


# ---- Pump.dev ----
PUMPDEV_API_KEY=
PUMPDEV_WALLET_PUBLIC=
PUMPDEV_WALLET_PRIVATE=


# ---- Telegram ----
# Bot API (for sending messages to users)
TELEGRAM_BOT_TOKEN=

# MTProto API (for ingesting messages from channels — get credentials at https://my.telegram.org)
TELEGRAM_MTPROTO_API_ID=
TELEGRAM_MTPROTO_API_HASH=
TELEGRAM_MTPROTO_SESSION=

# ---- Telegram Ingestion Seed ----
# Registers Telegram channels on boot from src/ca/ingestion/telegram/infrastructure/seeds/telegram-channels.seed.ts
# Titles/usernames are resolved from Telegram via MTProto when not provided.
INGESTION_TELEGRAM_SEED_ENABLED=false
# After seeding, automatically start the real-time listener on the registered channels.
INGESTION_TELEGRAM_SEED_AUTO_START=true
# Optional override of the in-code seed list.
# Format: comma-separated "channelId" or "channelId|username|title".
# INGESTION_TELEGRAM_SEED_CHANNELS=

# File-backed cache of resolved channel metadata so titles don't have to be
# re-resolved via MTProto on every boot. Defaults to ./.cache/telegram-channel-metadata.json
# (created automatically; safe to gitignore).
INGESTION_TELEGRAM_METADATA_CACHE_FILE=
# When true (default), the seeder runs a post-seed pass that replaces any
# channels still on the "Telegram channel <peerId>" fallback title once the
# MTProto session (or cache) can resolve a real one.
INGESTION_TELEGRAM_BACKFILL_ENABLED=true


# ---- Local uploads (crypto-news media) ----
# Directory where crypto-news photo attachments are written by the
# MTProto media downloader (relative to process.cwd() unless absolute).
# Files are NOT persisted across container rebuilds — configure a
# mounted volume in production to keep them.
UPLOADS_ROOT=./uploads


# ---- Telegram Publishing ----
# Switch from mock sender to real MTProto sendMessage.
# Requires TELEGRAM_MTPROTO_API_ID, _HASH, _SESSION above to be set.
PUBLISHING_TELEGRAM_USE_REAL_MTPROTO=false


# ---- Chain Dexter Bot (Telegram wrapper) ----
# Bot API token for the public chain-dexter-bot Telegram bot.
CHAIN_DEXTER_BOT_TOKEN=
# Optional HMAC secret for webhook validation (recommended in prod).
CHAIN_DEXTER_WEBHOOK_SECRET=
# Ingest mode: "webhook" for prod (Telegram POSTs to /chain-dexter/webhook),
# "polling" for dev (long-polling getUpdates loop).
CHAIN_DEXTER_INGEST_MODE=webhook
# Polling interval in ms (only used when INGEST_MODE=polling). Default 1000.
CHAIN_DEXTER_POLLING_INTERVAL_MS=1000
# Comma-separated default trade button codes. Default: DEX,PHO,TRO.
CHAIN_DEXTER_DEFAULT_TRADE_BUTTONS=DEX,PHO,TRO


# ---- Analytics (Background Evaluation Jobs) ----
# Comma-separated hours at which to evaluate past token calls.
# Default: 24h, 7d, 30d. Each scored token spawns one job per horizon.
ANALYTICS_EVALUATION_HORIZONS_HOURS=24,168,720

# Cron expression for the background scheduler tick.
# Default: every 5 minutes. See https://crontab.guru for syntax.
ANALYTICS_SCHEDULER_CRON=*/5 * * * *

# Set to "false" to disable the scheduler entirely (manual /evaluate-due only).
ANALYTICS_SCHEDULER_ENABLED=true

# Max jobs processed per scheduler tick (back-pressure control).
ANALYTICS_SCHEDULER_BATCH_SIZE=50


# ---- Postgres (TypeORM) ----
# Master switch: when false, the 3 Tier-1 repositories (telegram-channel,
# canonical-token-call, channel-reputation-stats) fall back to their in-memory
# implementations. Set to "true" once `docker compose up -d postgres` is running.
DATABASE_ENABLED=false

# Connection. Defaults match docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=alpha_meta_token_scanner
POSTGRES_PASSWORD=alpha_meta_token_scanner
POSTGRES_DB=alpha_meta_token_scanner

# DDL mode. synchronize=true auto-creates/updates schema from @Entity() classes.
# OK for dev/staging; disable and use migrations in production.
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false


# ---- Redis ----
# Master switch for Redis (used for milestone dedup cache).
# Defaults to true; set to "false" to disable.
REDIS_ENABLED=true

# Connection. Defaults match docker-compose.yml.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional password (empty = no auth). Matches docker-compose.yml --requirepass.
REDIS_PASSWORD=

# Redis database index (0-15). Default 0.
REDIS_DB=0

# ---- Milestone notifications ----
# How many hours a published call remains monitored (default 72h)
MILESTONE_ACTIVE_WINDOW_HOURS=72
# Cron expression for the live milestone scheduler (default every 5 minutes)
MILESTONE_SCHEDULER_CRON=*/5 * * * *
# Enable/disable the scheduler (default true)
MILESTONE_SCHEDULER_ENABLED=true
# Batch size for processing calls per scheduler tick (default 30)
MILESTONE_SCHEDULER_BATCH_SIZE=30


# ---- Dedup semantic-gated LLM arbiter ----
# Cosine threshold at/above which DeduplicationService.checkSemantic
# routes a 'different'-zone pair to the LLM arbiter before
# fail-opening. Set to 0 to disable (byte-identical to pre-gate
# behavior). Default 0.70 — see
# .omo/plans/dedup-semantic-arbiter.md for the empirical rationale.
DEDUP_SEMANTIC_ARBITER_THRESHOLD=0.70
