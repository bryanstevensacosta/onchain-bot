{
  "name": "onchain-bot",
  "version": "1.0.0",
  "description": "Onchain Bot — monorepo: NestJS alpha-call pipeline backend + React/Vite dashboard frontend",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/cleanup-ports.mjs",
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node -e \"console.log('Backend logs → apps/backend/logs/backend-development.log');\" && LOG_DIR=apps/backend/logs node scripts/cleanup-ports.mjs --force 3030 && LOG_DIR=apps/backend/logs npm run start:dev -w @onchain-bot/backend",
    "dev:frontend": "node scripts/cleanup-ports.mjs --force 5173 && npm run dev -w @onchain-bot/frontend",
    "dev:ingestion": "node scripts/cleanup-ports.mjs --force 3031 && npm run start:dev -w @onchain-bot/ingestion-telegram",
    "dev:backend-only": "npm run dev:backend",
    "dev:frontend-only": "npm run dev:frontend",
    "build": "npm run build -w @onchain-bot/backend && npm run build -w @onchain-bot/frontend",
    "build:backend": "npm run build -w @onchain-bot/backend",
    "build:frontend": "npm run build -w @onchain-bot/frontend",
    "build:ingestion": "npm run build -w @onchain-bot/ingestion-telegram",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm test -w @onchain-bot/backend",
    "test:frontend": "npm test -w @onchain-bot/frontend",
    "test:ingestion": "npm test -w @onchain-bot/ingestion-telegram",
    "test:ci": "npm run test -w @onchain-bot/backend --if-present && npm run test -w @onchain-bot/frontend --if-present && npm run test -w @onchain-bot/ingestion-telegram --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:backend": "npm run lint -w @onchain-bot/backend",
    "lint:frontend": "npm run lint -w @onchain-bot/frontend",
    "lint:ingestion": "npm run lint -w @onchain-bot/ingestion-telegram",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\"",
    "docker:up": "docker compose -f apps/backend/docker-compose.yml up -d",
    "docker:down": "docker compose -f apps/backend/docker-compose.yml down",
    "cleanup": "node scripts/cleanup-ports.mjs",
    "docs:check": "node scripts/check-docs-staleness.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  }
}
