{
  "name": "alpha-meta-token-scanner",
  "version": "0.0.1",
  "description": "Alpha Meta Token Scanner — monorepo: NestJS alpha-call pipeline backend + React/Vite dashboard frontend",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/cleanup-ports.mjs",
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/cleanup-ports.mjs --force 3030 && npm run start:dev -w @alpha-meta-token-scanner/backend",
    "dev:frontend": "node scripts/cleanup-ports.mjs --force 5173 && npm run dev -w @alpha-meta-token-scanner/frontend",
    "dev:backend-only": "npm run dev:backend",
    "dev:frontend-only": "npm run dev:frontend",
    "build": "npm run build -w @alpha-meta-token-scanner/backend && npm run build -w @alpha-meta-token-scanner/frontend",
    "build:backend": "npm run build -w @alpha-meta-token-scanner/backend",
    "build:frontend": "npm run build -w @alpha-meta-token-scanner/frontend",
    "test": "npm run test -w @alpha-meta-token-scanner/backend --if-present && npm run test -w @alpha-meta-token-scanner/frontend --if-present",
    "test:backend": "npm test -w @alpha-meta-token-scanner/backend",
    "test:frontend": "npm test -w @alpha-meta-token-scanner/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:backend": "npm run lint -w @alpha-meta-token-scanner/backend",
    "lint:frontend": "npm run lint -w @alpha-meta-token-scanner/frontend",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\"",
    "docker:up": "docker compose -f apps/backend/docker-compose.yml up -d",
    "docker:down": "docker compose -f apps/backend/docker-compose.yml down",
    "cleanup": "node scripts/cleanup-ports.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  }
}
