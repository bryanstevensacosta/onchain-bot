# =====================================================================
# CENTRALIZED INGESTION SERVICE - ENVIRONMENT VARIABLES
# =====================================================================
# Copy this file to `.env.ingestion` and fill in your real values.
# The ingestion service runs as a standalone microservice that provides
# a single MTProto connection to Telegram and distributes messages to
# multiple backend environments via Server-Sent Events (SSE).
# =====================================================================

# ─────────────────────────────────────────────────────────────
# MTProto Configuration
# ─────────────────────────────────────────────────────────────
# Get credentials at https://my.telegram.org/apps
# IMPORTANT: Only ONE service should use these credentials at a time
# to avoid AUTH_KEY_DUPLICATED errors from Telegram.

# Telegram application ID (8-digit integer)
INGESTION_TELEGRAM_MTPROTO_API_ID=

# Telegram application hash (32-character hex string)
INGESTION_TELEGRAM_MTPROTO_API_HASH=

# MTProto session string (base64-encoded)
# Generate using: cd apps/backend && npm run telegram:gen-session
# This session authenticates the service with Telegram servers.
INGESTION_TELEGRAM_MTPROTO_SESSION=


# ─────────────────────────────────────────────────────────────
# Channel Seeder Configuration
# ─────────────────────────────────────────────────────────────
# Defines which Telegram channels to monitor for KOL alpha calls
# and crypto news. Channels are joined automatically at startup.

# Enable/disable channel seeding (default: true)
INGESTION_TELEGRAM_SEED_ENABLED=true

# Automatically start listening after seeding (default: true)
INGESTION_TELEGRAM_SEED_AUTO_START=true

# KOL channel configurations (JSON array)
# Each entry: { "channelId": "<peer_id>", "displayName": "<name>" }
# Example: [{"channelId":"-1009876543210","displayName":"KOL Alpha Signals"}]
INGESTION_TELEGRAM_SEED_KOLS=[]

# Crypto news channel configurations (JSON array)
# Each entry: { "channelId": "<peer_id>", "displayName": "<name>" }
# Example: [{"channelId":"-1001234567890","displayName":"Crypto News Channel"}]
INGESTION_TELEGRAM_SEED_NEWS=[]

# File-backed cache of resolved channel metadata (titles, usernames)
# Prevents re-resolving via MTProto on every restart.
# Default: ./.cache/telegram-channel-metadata.json
INGESTION_TELEGRAM_METADATA_CACHE_FILE=

# When true, backfill missing channel titles after initial seed
# Default: true
INGESTION_TELEGRAM_BACKFILL_ENABLED=true


# ─────────────────────────────────────────────────────────────
# API Server Configuration
# ─────────────────────────────────────────────────────────────
# HTTP server settings for SSE streaming, media serving, and health checks.

# Port for the ingestion service API (default: 3031)
INGESTION_API_PORT=3031

# Host binding (default: 0.0.0.0 for Docker, 127.0.0.1 for local)
INGESTION_API_HOST=0.0.0.0

# Base URL for constructing media URLs in SSE payloads
# Used to build: ${BASE_URL}/api/media/:channelId/:messageId/:index
# Production example: http://144.126.203.139:3031
# Local dev example: http://localhost:3031
INGESTION_API_BASE_URL=http://localhost:3031

# Root directory for media file storage (relative or absolute)
# Media files are stored in: ${UPLOADS_ROOT}/crypto-news/media/:channelId/
# Default: ./uploads
INGESTION_UPLOADS_ROOT=./uploads


# ─────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────
# Redis is used for:
# - Last-seen message ID tracking (cursor persistence across restarts)
# - Deduplication state (prevents re-broadcasting old messages)

# Redis host (default: redis for Docker, localhost for local)
REDIS_HOST=redis

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis database index (0-15, default: 0)
REDIS_DB=0

# Redis password (optional, leave empty if no auth required)
REDIS_PASSWORD=


# ─────────────────────────────────────────────────────────────
# Postgres Configuration (Optional)
# ─────────────────────────────────────────────────────────────
# The ingestion service optionally stores raw message text in Postgres
# for compliance with Telegram ToS (text not included in SSE payloads).
# Backend environments can retrieve text via separate DB queries if needed.

# Enable/disable Postgres storage (default: false)
DATABASE_ENABLED=false

# Connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ingestion
POSTGRES_PASSWORD=
POSTGRES_DB=ingestion_metadata

# DDL mode (default: true for dev, false for prod)
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false


# ─────────────────────────────────────────────────────────────
# Safety Configuration (Anti-Ban Protection)
# ─────────────────────────────────────────────────────────────
# Telegram enforces rate limits and monitors for spam/bot behavior.
# These settings implement staggered polling, jitter, and FLOOD_WAIT
# handling to maintain account health and avoid bans.
#
# See: https://core.telegram.org/api/terms
#      https://core.telegram.org/api/errors

# Maximum channels to monitor (default: 50)
# Exceeding this triggers a warning and degraded polling frequency.
# Requirement 11.1: Stay well below Telegram's flood limits.
INGESTION_SAFETY_MAX_CHANNELS=50

# Base polling interval per channel in milliseconds (default: 90000 = 90 seconds)
# Requirement 11.1: Conservative default to mimic human browsing behavior.
INGESTION_SAFETY_POLL_INTERVAL_MS=90000

# Jitter percentage for staggered polling (default: 30)
# Adds ±30% randomization to poll intervals to avoid predictable patterns.
# Requirement 11.1: Prevents automated detection.
INGESTION_SAFETY_JITTER_PERCENT=30

# Sleep window start time in UTC (default: 04:00)
# During the sleep window, all polling operations are paused.
# Requirement 11.3: Reduces activity during high-risk periods.
INGESTION_SAFETY_SLEEP_WINDOW_START=04:00

# Sleep window end time in UTC (default: 08:00)
# Requirement 11.3: Resumes polling after the sleep window.
INGESTION_SAFETY_SLEEP_WINDOW_END=08:00

# FLOOD_WAIT alert threshold (default: 10)
# Triggers an alert if FLOOD_WAIT errors exceed this count in 24 hours.
# Requirement 11.2: Monitors ban risk indicators.
INGESTION_SAFETY_FLOOD_THRESHOLD_24H=10

# FLOOD_WAIT initial backoff in milliseconds (default: 5000 = 5 seconds)
# Starting delay when Telegram returns a FLOOD_WAIT error.
# Requirement 11.2: Exponential backoff strategy.
INGESTION_SAFETY_FLOOD_BACKOFF_INITIAL_MS=5000

# FLOOD_WAIT backoff multiplier (default: 2)
# Each retry doubles the backoff duration: 5s → 10s → 20s → ...
# Requirement 11.2: Exponential backoff.
INGESTION_SAFETY_FLOOD_BACKOFF_MULTIPLIER=2

# FLOOD_WAIT maximum backoff in milliseconds (default: 3600000 = 1 hour)
# Caps the backoff duration to prevent excessively long waits.
# Requirement 11.2: Balance between compliance and availability.
INGESTION_SAFETY_FLOOD_BACKOFF_MAX_MS=3600000

# FLOOD_WAIT maximum retry attempts (default: 5)
# After exhausting retries, the service logs an error and skips the operation.
# Requirement 11.2: Prevents infinite retry loops.
INGESTION_SAFETY_FLOOD_MAX_ATTEMPTS=5


# ─────────────────────────────────────────────────────────────
# Observability & Monitoring
# ─────────────────────────────────────────────────────────────

# Enable structured JSON logging (default: true)
LOG_JSON=true

# Log level (default: info)
# Options: error, warn, info, debug, verbose
LOG_LEVEL=info

# Enable Prometheus metrics endpoint at /metrics (default: false)
METRICS_ENABLED=false


# ─────────────────────────────────────────────────────────────
# Node.js Runtime
# ─────────────────────────────────────────────────────────────

# Node environment (default: production)
# Options: development, staging, production
NODE_ENV=production
